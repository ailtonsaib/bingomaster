{
  "name": "Alerta de Pagamento de Plano via Gmail",
  "description": "Dispara email para o admin quando o status de uma solicita\u00e7\u00e3o de plano muda para 'approved' (pagamento confirmado)",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"approved\") and (.trigger.old_data.status != \"approved\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "PlanRequest"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "alerta_de_pagamento_de_plano_via_gmail",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyPlanPayment",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyPlanPayment"
  }
}