{
  "name": "Notificar Cliente \u2014 OS Conclu\u00edda",
  "description": "Envia email autom\u00e1tico ao cliente quando o status de uma Ordem de Servi\u00e7o muda para conclu\u00edda",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"status\") != null) and (.trigger.data.status == \"concluida\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "ServiceOrder"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notificar_cliente_os_conclu_da",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyServiceOrderCompleted",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyServiceOrderCompleted"
  }
}