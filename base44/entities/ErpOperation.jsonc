{
  "name": "ErpOperation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "default": "saida",
      "description": "Tipo da opera\u00e7\u00e3o: entrada ou saida"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da opera\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o"
    },
    "cfop": {
      "type": "string",
      "description": "CFOP dentro do estado (in\u00edcio 1 p/ entrada, 5 p/ sa\u00edda)"
    },
    "cfop_fora_estado": {
      "type": "string",
      "description": "CFOP fora do estado (in\u00edcio 2 p/ entrada, 6 p/ sa\u00edda)"
    },
    "cfop_importacao_exportacao": {
      "type": "string",
      "description": "CFOP de importa\u00e7\u00e3o (entrada, in\u00edcio 3) ou exporta\u00e7\u00e3o (sa\u00edda, in\u00edcio 7)"
    },
    "nature_operation": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o"
    },
    "description": {
      "type": "string"
    },
    "is_patrimonio": {
      "type": "boolean",
      "default": false,
      "description": "Se a opera\u00e7\u00e3o de entrada gera bem patrimonial (imobilizado)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "type",
    "name",
    "cfop"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}