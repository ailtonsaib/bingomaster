{
  "name": "ErpOperation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "default": "saida",
      "description": "Tipo da opera\u00e7\u00e3o: entrada ou saida"
    },
    "kind": {
      "type": "string",
      "enum": [
        "comercializacao",
        "industrializacao",
        "devolucao_venda",
        "devolucao_compra",
        "transferencia",
        "outra"
      ],
      "default": "comercializacao",
      "description": "Natureza base da opera\u00e7\u00e3o \u2014 usada para sugerir o CFOP correto na regra fiscal (dentro/fora do estado e com/sem ST)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da opera\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o"
    },
    "nature_operation": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o (texto livre)"
    },
    "description": {
      "type": "string"
    },
    "flag_contabil": {
      "type": "boolean",
      "default": true,
      "description": "Se marcada, a opera\u00e7\u00e3o gera lan\u00e7amento cont\u00e1bil; desmarcada, n\u00e3o vai para a contabilidade"
    },
    "flag_fiscal": {
      "type": "boolean",
      "default": true,
      "description": "Se marcada, a opera\u00e7\u00e3o \u00e9 fiscal: exige CFOP e vai para o fiscal (SPEDs fiscais)"
    },
    "flag_financeiro": {
      "type": "boolean",
      "default": true,
      "description": "Se marcada, a opera\u00e7\u00e3o gera as parcelas no contas a pagar"
    },
    "exige_ordem_compra": {
      "type": "boolean",
      "default": false,
      "description": "Se marcada, a entrada com esta opera\u00e7\u00e3o exige ordem de compra vinculada (produtos e rateio v\u00eam da OC); desmarcada, exige itens \u2014 produto cadastrado traz a conta cont\u00e1bil e o setor para o rateio automaticamente, item n\u00e3o cadastrado exige rateio informado"
    },
    "cfop_dentro_estado": {
      "type": "string",
      "description": "CFOP da opera\u00e7\u00e3o dentro do estado (mesma UF) \u2014 opcional; obrigat\u00f3rio quando a opera\u00e7\u00e3o \u00e9 fiscal"
    },
    "cfop_fora_estado": {
      "type": "string",
      "description": "CFOP da opera\u00e7\u00e3o fora do estado (interestadual) \u2014 opcional; obrigat\u00f3rio quando a opera\u00e7\u00e3o \u00e9 fiscal"
    },
    "cfop_importacao": {
      "type": "string",
      "description": "CFOP da opera\u00e7\u00e3o de importa\u00e7\u00e3o (exterior) \u2014 opcional; obrigat\u00f3rio quando a opera\u00e7\u00e3o \u00e9 fiscal"
    },
    "is_patrimonio": {
      "type": "boolean",
      "default": false,
      "description": "Se a opera\u00e7\u00e3o de entrada gera bem patrimonial (imobilizado)"
    },
    "tem_retencao": {
      "type": "boolean",
      "default": false,
      "description": "Se a opera\u00e7\u00e3o de entrada tem reten\u00e7\u00e3o de impostos (IRRF, PIS, COFINS, CSLL, INSS, ISS) \u2014 parametrizada por imposto com fornecedor destinat\u00e1rio, dia de vencimento, conta cont\u00e1bil e hist\u00f3rico padr\u00e3o"
    },
    "retention_params": {
      "type": "array",
      "default": [],
      "description": "Impostos retidos na opera\u00e7\u00e3o: cada imposto selecionado na entrada da nota gera financeiro (conta a pagar pr\u00f3pria) e lan\u00e7amento cont\u00e1bil com a conta e o hist\u00f3rico configurados, abatendo o valor retido do fornecedor",
      "items": {
        "type": "object",
        "properties": {
          "tax_type": {
            "type": "string",
            "enum": [
              "IRRF",
              "PIS",
              "COFINS",
              "CSLL",
              "INSS",
              "ISS"
            ],
            "description": "Imposto retido"
          },
          "rate": {
            "type": "number",
            "default": 0,
            "description": "Al\u00edquota da reten\u00e7\u00e3o (%) aplicada sobre o total da nota"
          },
          "supplier_id": {
            "type": "string",
            "description": "ID do fornecedor destinat\u00e1rio da reten\u00e7\u00e3o (ErpPartner)"
          },
          "supplier_code": {
            "type": "string",
            "description": "C\u00f3digo do fornecedor destinat\u00e1rio da reten\u00e7\u00e3o"
          },
          "supplier_name": {
            "type": "string",
            "description": "Fornecedor destinat\u00e1rio da reten\u00e7\u00e3o (cache)"
          },
          "due_day": {
            "type": "number",
            "default": 0,
            "description": "Dia do m\u00eas do vencimento do imposto retido (financeiro)"
          },
          "account_id": {
            "type": "string",
            "description": "ID da conta cont\u00e1bil da reten\u00e7\u00e3o (ErpChartAccount)"
          },
          "account_code": {
            "type": "string",
            "description": "C\u00f3digo da conta cont\u00e1bil (cache)"
          },
          "account_name": {
            "type": "string",
            "description": "Nome da conta cont\u00e1bil (cache)"
          },
          "history_id": {
            "type": "string",
            "description": "ID do hist\u00f3rico padr\u00e3o (ErpStandardHistory)"
          },
          "history_code": {
            "type": "string",
            "description": "C\u00f3digo do hist\u00f3rico padr\u00e3o (cache)"
          },
          "history_text": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o do hist\u00f3rico padr\u00e3o (cache)"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "type",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}