{
  "name": "ErpOperation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "default": "saida",
      "description": "Tipo da opera\u00e7\u00e3o: entrada ou saida"
    },
    "kind": {
      "type": "string",
      "enum": [
        "comercializacao",
        "industrializacao",
        "devolucao_venda",
        "devolucao_compra",
        "transferencia",
        "outra"
      ],
      "default": "comercializacao",
      "description": "Natureza base da opera\u00e7\u00e3o \u2014 usada para sugerir o CFOP correto na regra fiscal (dentro/fora do estado e com/sem ST)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da opera\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o"
    },
    "nature_operation": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o (texto livre)"
    },
    "description": {
      "type": "string"
    },
    "flag_contabil": {
      "type": "boolean",
      "default": true,
      "description": "Se marcada, a opera\u00e7\u00e3o gera lan\u00e7amento cont\u00e1bil; desmarcada, n\u00e3o vai para a contabilidade"
    },
    "flag_fiscal": {
      "type": "boolean",
      "default": true,
      "description": "Se marcada, a opera\u00e7\u00e3o \u00e9 fiscal: exige CFOP e vai para o fiscal (SPEDs fiscais)"
    },
    "flag_financeiro": {
      "type": "boolean",
      "default": true,
      "description": "Se marcada, a opera\u00e7\u00e3o gera as parcelas no contas a pagar"
    },
    "cfop_dentro_estado": {
      "type": "string",
      "description": "CFOP da opera\u00e7\u00e3o dentro do estado (mesma UF) \u2014 opcional; obrigat\u00f3rio quando a opera\u00e7\u00e3o \u00e9 fiscal"
    },
    "cfop_fora_estado": {
      "type": "string",
      "description": "CFOP da opera\u00e7\u00e3o fora do estado (interestadual) \u2014 opcional; obrigat\u00f3rio quando a opera\u00e7\u00e3o \u00e9 fiscal"
    },
    "cfop_importacao": {
      "type": "string",
      "description": "CFOP da opera\u00e7\u00e3o de importa\u00e7\u00e3o (exterior) \u2014 opcional; obrigat\u00f3rio quando a opera\u00e7\u00e3o \u00e9 fiscal"
    },
    "is_patrimonio": {
      "type": "boolean",
      "default": false,
      "description": "Se a opera\u00e7\u00e3o de entrada gera bem patrimonial (imobilizado)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "type",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}