{
  "name": "ErpOperation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "default": "saida",
      "description": "Tipo da opera\u00e7\u00e3o: entrada ou saida"
    },
    "kind": {
      "type": "string",
      "enum": [
        "comercializacao",
        "industrializacao",
        "devolucao_venda",
        "devolucao_compra",
        "transferencia",
        "outra"
      ],
      "default": "comercializacao",
      "description": "Natureza base da opera\u00e7\u00e3o \u2014 usada para sugerir o CFOP correto na regra fiscal (dentro/fora do estado e com/sem ST)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da opera\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o"
    },
    "nature_operation": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o (texto livre)"
    },
    "description": {
      "type": "string"
    },
    "is_patrimonio": {
      "type": "boolean",
      "default": false,
      "description": "Se a opera\u00e7\u00e3o de entrada gera bem patrimonial (imobilizado)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "type",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}