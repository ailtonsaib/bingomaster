{
  "name": "ErpFleetDriver",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo da empresa)"
    },
    "name": {
      "type": "string",
      "description": "Nome do motorista"
    },
    "cpf": {
      "type": "string",
      "description": "CPF do motorista"
    },
    "cnh_number": {
      "type": "string",
      "description": "N\u00famero do registro da CNH"
    },
    "cnh_category": {
      "type": "string",
      "description": "Categoria da CNH (A, B, C, D, E ou combina\u00e7\u00f5es)"
    },
    "cnh_expiry": {
      "type": "string",
      "description": "Data de validade da CNH (ISO)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "admission_date": {
      "type": "string",
      "description": "Data de admiss\u00e3o (ISO)"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "inativo"
      ],
      "default": "ativo",
      "description": "Situa\u00e7\u00e3o do motorista: ativo ou inativo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}