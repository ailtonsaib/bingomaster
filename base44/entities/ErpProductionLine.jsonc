{
  "name": "ErpProductionLine",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo da empresa)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da linha de produ\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome da linha de produ\u00e7\u00e3o (ex: Linha 1 \u2014 Envase Autom\u00e1tico)"
    },
    "stage_id": {
      "type": "string",
      "description": "ID da etapa de produ\u00e7\u00e3o vinculada (ErpProductionStage)"
    },
    "stage_name": {
      "type": "string",
      "description": "Nome da etapa de produ\u00e7\u00e3o vinculada (cache)"
    },
    "products": {
      "type": "array",
      "default": [],
      "description": "Produtos produzidos nesta linha com a velocidade nominal de cada um (quantidade produzida por hora) \u2014 o mesmo produto pode ser cadastrado em linhas diferentes; a velocidade nominal \u00e9 a base do c\u00e1lculo de efici\u00eancia de produ\u00e7\u00e3o (capacidade nominal \u00d7 horas \u00d7 efici\u00eancia)",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "ID do produto (ErpProduct)"
          },
          "product_name": {
            "type": "string",
            "description": "Nome do produto (cache)"
          },
          "product_code": {
            "type": "string",
            "description": "C\u00f3digo do produto (cache)"
          },
          "units_per_hour": {
            "type": "number",
            "default": 0,
            "description": "Velocidade nominal \u2014 quantidade que a linha produz deste produto por hora"
          }
        }
      }
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da linha de produ\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a linha est\u00e1 ativa"
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}