{
  "name": "ErpRequisition",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero da solicita\u00e7\u00e3o (ex: SC 001/2026)"
    },
    "request_date": {
      "type": "string",
      "description": "Data da solicita\u00e7\u00e3o (ISO)"
    },
    "department_id": {
      "type": "string"
    },
    "department_name": {
      "type": "string",
      "description": "Departamento solicitante (cache)"
    },
    "requested_by": {
      "type": "string",
      "description": "Solicitante"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media"
    },
    "description": {
      "type": "string",
      "description": "Itens/descri\u00e7\u00e3o da solicita\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "aprovada",
        "reprovada",
        "atendida"
      ],
      "default": "aberta"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "number",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}