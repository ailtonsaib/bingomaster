{
  "name": "PortalUser",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email do usu\u00e1rio (login)"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash bcrypt da senha"
    },
    "name": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio"
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 administrador do portal"
    },
    "can_access_bingo": {
      "type": "boolean",
      "default": true,
      "description": "Se tem acesso ao BingoPremier"
    },
    "can_access_finance": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao Controle de Finan\u00e7as"
    },
    "can_access_chamados": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao sistema de Chamados"
    },
    "can_access_sped": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao Validador SPED"
    },
    "can_access_pdv": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao PDV (Frente de Caixa)"
    },
    "can_access_diagnostic": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao Diagn\u00f3stico Automotivo"
    },
    "can_access_erp": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso ao ERP (Ind\u00fastria + Com\u00e9rcio)"
    },
    "erp_plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "enterprise"
      ],
      "default": "free",
      "description": "Plano do ERP: free (50 produtos), pro (produtos ilimitados), enterprise (multi-empresa)"
    },
    "diagnostic_plan": {
      "type": "string",
      "enum": [
        "free",
        "teste",
        "bronze",
        "master"
      ],
      "default": "free",
      "description": "Plano do Diagn\u00f3stico Automotivo: free (5 an\u00e1lises, 5 clientes, 5 ve\u00edculos, sem exclus\u00e3o), teste (10 OS, sem exclus\u00e3o), bronze (ilimitado, com exclus\u00e3o) ou master (ilimitado)"
    },
    "diagnostic_acquisition_price": {
      "type": "number",
      "default": 0,
      "description": "Valor de aquisi\u00e7\u00e3o do plano Bronze (pago uma vez no cadastro)"
    },
    "diagnostic_monthly_price": {
      "type": "number",
      "default": 0,
      "description": "Valor da mensalidade do plano Bronze"
    },
    "diagnostic_registration_date": {
      "type": "string",
      "description": "Data de cadastro da empresa no sistema (ISO) \u2014 definida pelo administrador"
    },
    "diagnostic_due_date": {
      "type": "string",
      "description": "Data de vencimento da pr\u00f3xima mensalidade (ISO)"
    },
    "diagnostic_grace_end_date": {
      "type": "string",
      "description": "Data limite do per\u00edodo de toler\u00e2ncia de 15 dias ap\u00f3s vencimento (ISO)"
    },
    "diagnostic_blocked_date": {
      "type": "string",
      "description": "Data em que o sistema foi bloqueado por inadimpl\u00eancia (ISO)"
    },
    "diagnostic_last_payment_date": {
      "type": "string",
      "description": "Data do \u00faltimo pagamento de mensalidade recebido (ISO)"
    },
    "diagnostic_payment_status": {
      "type": "string",
      "enum": [
        "active",
        "grace_period",
        "blocked"
      ],
      "default": "active",
      "description": "Status do pagamento da assinatura: active (em dia), grace_period (em toler\u00e2ncia), blocked (bloqueado)"
    },
    "bingo_plan": {
      "type": "string",
      "default": "free",
      "description": "Plano do bingo"
    },
    "sped_plan": {
      "type": "string",
      "default": "free",
      "description": "Plano do Validador SPED"
    },
    "finance_plan": {
      "type": "string",
      "enum": [
        "free",
        "full"
      ],
      "default": "free",
      "description": "Plano do Controle de Finan\u00e7as (free=10 mov., full=ilimitado)"
    },
    "finance_transaction_limit": {
      "type": "number",
      "default": 10,
      "description": "Limite de movimenta\u00e7\u00f5es financeiras"
    },
    "finance_transactions_used": {
      "type": "number",
      "default": 0,
      "description": "Movimenta\u00e7\u00f5es j\u00e1 utilizadas"
    },
    "finance_full_access": {
      "type": "boolean",
      "default": false,
      "description": "Se tem acesso completo \u00e0s finan\u00e7as (liberado pelo admin)"
    },
    "finance_release_requested": {
      "type": "boolean",
      "default": false,
      "description": "Se solicitou libera\u00e7\u00e3o de acesso completo"
    },
    "finance_plan_price": {
      "type": "number",
      "default": 49.9,
      "description": "Valor do plano de acesso completo \u00e0s finan\u00e7as (definido pelo admin)"
    },
    "device_ip": {
      "type": "string",
      "description": "IP da m\u00e1quina do \u00faltimo login"
    },
    "last_login_at": {
      "type": "string",
      "description": "Data/hora do \u00faltimo login (ISO)"
    },
    "current_app": {
      "type": "string",
      "enum": [
        "portal",
        "bingo",
        "finance",
        "chamados",
        "sped",
        "pdv",
        "diagnostic",
        "erp"
      ],
      "default": "portal",
      "description": "Aplicativo que o usu\u00e1rio est\u00e1 usando no momento"
    },
    "must_change_password": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio deve trocar a senha no pr\u00f3ximo acesso"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o usu\u00e1rio est\u00e1 ativo"
    }
  },
  "required": [
    "email",
    "password_hash",
    "name"
  ]
}