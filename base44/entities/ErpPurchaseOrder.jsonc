{
  "name": "ErpPurchaseOrder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo da empresa)"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero do pedido de compra (ex: PC 001/2026)"
    },
    "supplier_id": {
      "type": "string",
      "description": "ID do fornecedor (ErpSupplier)"
    },
    "supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor (cache)"
    },
    "supplier_cnpj": {
      "type": "string",
      "description": "CNPJ do fornecedor (cache)"
    },
    "quotation_id": {
      "type": "string",
      "description": "ID da tomada de pre\u00e7o vinculada (ErpQuotation) \u2014 opcional"
    },
    "quotation_number": {
      "type": "string",
      "description": "N\u00famero da tomada de pre\u00e7o (cache)"
    },
    "requisition_id": {
      "type": "string",
      "description": "ID da solicita\u00e7\u00e3o de origem (ErpRequisition) \u2014 tra\u00e7a o rateio at\u00e9 a entrada da nota"
    },
    "requisition_number": {
      "type": "string",
      "description": "N\u00famero da solicita\u00e7\u00e3o de origem (cache)"
    },
    "apportionments": {
      "type": "array",
      "default": [],
      "description": "Rateio (setor + conta cont\u00e1bil) herdado da solicita\u00e7\u00e3o \u2014 acompanha o pedido at\u00e9 a entrada da nota para o lan\u00e7amento cont\u00e1bil",
      "items": {
        "type": "object",
        "properties": {
          "department_id": {
            "type": "string"
          },
          "department_name": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "account_code": {
            "type": "string"
          },
          "account_name": {
            "type": "string"
          },
          "rateio_type": {
            "type": "string",
            "enum": [
              "percent",
              "value"
            ],
            "default": "percent"
          },
          "percent": {
            "type": "number",
            "default": 0
          },
          "value": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "operation_id": {
      "type": "string",
      "description": "ID da opera\u00e7\u00e3o de entrada (ErpOperation) \u2014 definido na movimenta\u00e7\u00e3o de entrada"
    },
    "operation_name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o (cache) \u2014 definido na movimenta\u00e7\u00e3o de entrada"
    },
    "is_patrimonio": {
      "type": "boolean",
      "default": false,
      "description": "Se a opera\u00e7\u00e3o gera bem patrimonial (cache da opera\u00e7\u00e3o) \u2014 definido na movimenta\u00e7\u00e3o de entrada"
    },
    "department_id": {
      "type": "string",
      "description": "ID do setor/departamento solicitante (ErpDepartment) \u2014 usado para rotear a aprova\u00e7\u00e3o"
    },
    "department_name": {
      "type": "string",
      "description": "Nome do setor (cache)"
    },
    "emission_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o do pedido (ISO)"
    },
    "expected_date": {
      "type": "string",
      "description": "Data prevista de entrega (ISO)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_cost": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Itens do pedido de compra"
    },
    "total_value": {
      "type": "number",
      "default": 0,
      "description": "Valor total do pedido"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "nao_aplica",
        "aguardando_aprovacao",
        "aprovada",
        "reprovada"
      ],
      "default": "nao_aplica",
      "description": "Status da aprova\u00e7\u00e3o: nao_aplica, aguardando_aprovacao, aprovada, reprovada"
    },
    "approved_by_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que aprovou/reprovou (ErpUser)"
    },
    "approved_by_name": {
      "type": "string",
      "description": "Nome de quem aprovou/reprovou (cache)"
    },
    "approved_date": {
      "type": "string",
      "description": "Data da aprova\u00e7\u00e3o/reprova\u00e7\u00e3o (ISO)"
    },
    "approval_obs": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o da aprova\u00e7\u00e3o/reprova\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviada",
        "recebida_parcial",
        "recebida",
        "cancelada"
      ],
      "default": "rascunho",
      "description": "Status: rascunho, enviada (ao fornecedor), recebida_parcial, recebida (estoque entrada), cancelada"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "order_number",
    "total_value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}