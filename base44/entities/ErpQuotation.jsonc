{
  "name": "ErpQuotation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero da tomada de pre\u00e7o"
    },
    "quotation_date": {
      "type": "string",
      "description": "Data (ISO)"
    },
    "requisition_id": {
      "type": "string",
      "description": "ID da solicita\u00e7\u00e3o vinculada (ErpRequisition) \u2014 opcional"
    },
    "requisition_number": {
      "type": "string",
      "description": "N\u00famero da solicita\u00e7\u00e3o (cache)"
    },
    "description": {
      "type": "string",
      "description": "Objeto cotado (resumo)"
    },
    "items": {
      "type": "array",
      "default": [],
      "description": "Itens cotados (trazidos da solicita\u00e7\u00e3o ou lan\u00e7ados manualmente)",
      "items": {
        "type": "object",
        "properties": {
          "item_type": {
            "type": "string",
            "enum": [
              "cadastrado",
              "novo",
              "servico"
            ]
          },
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number",
            "description": "Valor unit\u00e1rio estimado"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "supplier_quotes": {
      "type": "array",
      "default": [],
      "description": "Cota\u00e7\u00f5es dos fornecedores (m\u00ednimo 3 para finalizar)",
      "items": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "quoted_value": {
            "type": "number",
            "description": "Valor total cotado pelo fornecedor"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "suggested_supplier_id": {
      "type": "string",
      "description": "ID do fornecedor com o menor pre\u00e7o (sugest\u00e3o do sistema)"
    },
    "suggested_supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor sugerido (cache)"
    },
    "suggested_value": {
      "type": "number",
      "default": 0,
      "description": "Menor valor sugerido (cache)"
    },
    "winner_supplier_id": {
      "type": "string",
      "description": "Fornecedor vencedor escolhido (pode diferir do sugerido)"
    },
    "winner_supplier_name": {
      "type": "string",
      "description": "Nome do vencedor (cache)"
    },
    "winner_value": {
      "type": "number",
      "default": 0,
      "description": "Valor do vencedor (cache)"
    },
    "change_reason": {
      "type": "string",
      "description": "Motivo da altera\u00e7\u00e3o do vencedor (obrigat\u00f3rio se diferente do sugerido)"
    },
    "quoted_value": {
      "type": "number",
      "default": 0,
      "description": "Valor final da tomada (cache do vencedor)"
    },
    "is_winner": {
      "type": "boolean",
      "default": false,
      "description": "Se a tomada j\u00e1 est\u00e1 finalizada com vencedor"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "fechada",
        "cancelada"
      ],
      "default": "aberta"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "number",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}