{
  "name": "ErpQuotation",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero da tomada de pre\u00e7o"
    },
    "quotation_date": {
      "type": "string",
      "description": "Data (ISO)"
    },
    "requisition_id": {
      "type": "string",
      "description": "ID da solicita\u00e7\u00e3o vinculada (ErpRequisition) \u2014 opcional"
    },
    "requisition_number": {
      "type": "string",
      "description": "N\u00famero da solicita\u00e7\u00e3o (cache)"
    },
    "description": {
      "type": "string",
      "description": "Objeto cotado (resumo)"
    },
    "items": {
      "type": "array",
      "default": [],
      "description": "Itens cotados (trazidos da solicita\u00e7\u00e3o ou lan\u00e7ados manualmente)",
      "items": {
        "type": "object",
        "properties": {
          "item_type": {
            "type": "string",
            "enum": [
              "cadastrado",
              "novo",
              "servico"
            ]
          },
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number",
            "description": "Valor unit\u00e1rio estimado"
          },
          "total": {
            "type": "number"
          }
        }
      }
    },
    "supplier_quotes": {
      "type": "array",
      "default": [],
      "description": "Cota\u00e7\u00f5es dos fornecedores (m\u00ednimo 3 para finalizar)",
      "items": {
        "type": "object",
        "properties": {
          "supplier_id": {
            "type": "string"
          },
          "supplier_name": {
            "type": "string"
          },
          "supplier_email": {
            "type": "string",
            "description": "Email do fornecedor (cache p/ envio)"
          },
          "quoted_value": {
            "type": "number",
            "description": "Valor total cotado pelo fornecedor"
          },
          "notes": {
            "type": "string"
          },
          "quote_token": {
            "type": "string",
            "description": "Token \u00fanico do link p\u00fablico enviado ao fornecedor"
          },
          "quote_status": {
            "type": "string",
            "enum": [
              "pendente",
              "respondida"
            ],
            "default": "pendente"
          },
          "responded_at": {
            "type": "string",
            "description": "Data da resposta (ISO)"
          },
          "items": {
            "type": "array",
            "default": [],
            "description": "Valores por item preenchidos pelo fornecedor no link p\u00fablico",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "unit": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "number"
                },
                "total": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    },
    "suggested_supplier_id": {
      "type": "string"
    },
    "suggested_supplier_name": {
      "type": "string"
    },
    "suggested_value": {
      "type": "number",
      "default": 0
    },
    "winner_supplier_id": {
      "type": "string"
    },
    "winner_supplier_name": {
      "type": "string"
    },
    "winner_value": {
      "type": "number",
      "default": 0
    },
    "change_reason": {
      "type": "string"
    },
    "quoted_value": {
      "type": "number",
      "default": 0
    },
    "is_winner": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "fechada",
        "cancelada"
      ],
      "default": "aberta"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "number",
    "description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}