{
  "name": "PDVCompanyConfig",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social da empresa emitente"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ (apenas n\u00fameros)"
    },
    "ie": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "im": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Municipal"
    },
    "crt": {
      "type": "number",
      "default": 1,
      "description": "CRT: 1=Simples Nacional, 2=Simples Nacional excesso, 3=Regime Normal (Lucro Real/Presumido)"
    },
    "regime_caixa": {
      "type": "boolean",
      "default": false,
      "description": "Regime de apura\u00e7\u00e3o do PIS/COFINS: true=Regime de Caixa, false=Regime de Compet\u00eancia. Aplic\u00e1vel apenas ao Regime Normal (CRT=3). No Simples Nacional o PIS/COFINS \u00e9 recolhido via DAS (n\u00e3o por opera\u00e7\u00e3o)."
    },
    "lucro_type": {
      "type": "string",
      "enum": [
        "real",
        "presumido",
        "nao_se_aplica"
      ],
      "default": "nao_se_aplica",
      "description": "Tipo de lucro (apenas CRT=3): real=Lucro Real, presumido=Lucro Presumido, nao_se_aplica=Simples Nacional. Lucro Presumido tem al\u00edquotas diferenciadas de PIS (0,65%) e COFINS (3,00%)."
    },
    "logo_url": {
      "type": "string",
      "description": "URL da logo da empresa para exibi\u00e7\u00e3o no menu e documentos"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero"
    },
    "complement": {
      "type": "string",
      "description": "Complemento"
    },
    "district": {
      "type": "string",
      "description": "Bairro"
    },
    "city": {
      "type": "string",
      "description": "Munic\u00edpio"
    },
    "uf": {
      "type": "string",
      "description": "UF (sigla do estado)"
    },
    "ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio (7 d\u00edgitos)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "responsible_name": {
      "type": "string",
      "description": "Nome do respons\u00e1vel pela empresa"
    },
    "responsible_cpf": {
      "type": "string",
      "description": "CPF do respons\u00e1vel (apenas n\u00fameros)"
    },
    "responsible_phone": {
      "type": "string",
      "description": "Telefone do respons\u00e1vel"
    },
    "responsible_email": {
      "type": "string",
      "description": "Email do respons\u00e1vel"
    },
    "accountant_name": {
      "type": "string",
      "description": "Nome do contador"
    },
    "accountant_company_name": {
      "type": "string",
      "description": "Nome da empresa de contabilidade"
    },
    "accountant_crc_number": {
      "type": "string",
      "description": "N\u00famero do CRC do contador"
    },
    "accountant_crc_uf": {
      "type": "string",
      "description": "UF do CRC do contador"
    },
    "accountant_cpf": {
      "type": "string",
      "description": "CPF do contador (apenas n\u00fameros)"
    },
    "accountant_cnpj": {
      "type": "string",
      "description": "CNPJ do escrit\u00f3rio de contabilidade (apenas n\u00fameros)"
    },
    "accountant_address": {
      "type": "string",
      "description": "Endere\u00e7o do escrit\u00f3rio de contabilidade"
    },
    "accountant_phone": {
      "type": "string",
      "description": "Telefone do contador"
    },
    "accountant_email": {
      "type": "string",
      "description": "Email do contador"
    },
    "nfe_series": {
      "type": "number",
      "default": 1,
      "description": "S\u00e9rie padr\u00e3o da NF-e"
    },
    "nfe_number_next": {
      "type": "number",
      "default": 1,
      "description": "Pr\u00f3ximo n\u00famero de NF-e a ser gerado"
    },
    "nfe_environment": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ],
      "default": "2",
      "description": "Ambiente: 1=Produ\u00e7\u00e3o, 2=Homologa\u00e7\u00e3o"
    }
  },
  "required": [
    "user_email",
    "razao_social",
    "cnpj"
  ]
}