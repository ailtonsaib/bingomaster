{
  "name": "ErpSector",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "department_id": {
      "type": "string",
      "description": "ID do departamento vinculado"
    },
    "department_name": {
      "type": "string",
      "description": "Nome do departamento (cache)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do setor"
    },
    "name": {
      "type": "string",
      "description": "Nome do setor"
    },
    "description": {
      "type": "string"
    },
    "estrutura_custo": {
      "type": "string",
      "enum": [
        "direto",
        "indireto"
      ],
      "description": "Estrutura de custo do setor: direto ou indireto"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "department_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}