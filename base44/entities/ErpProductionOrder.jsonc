{
  "name": "ErpProductionOrder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo da empresa)"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero da ordem de produ\u00e7\u00e3o (ex: OP 001/2026)"
    },
    "output_product_id": {
      "type": "string",
      "description": "ID do produto acabado a ser produzido (ErpProduct)"
    },
    "output_product_name": {
      "type": "string",
      "description": "Nome do produto acabado (cache)"
    },
    "output_product_code": {
      "type": "string",
      "description": "C\u00f3digo do produto acabado (cache)"
    },
    "output_quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade planejada a produzir"
    },
    "bom_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity_per_unit": {
            "type": "number",
            "description": "Quantidade consumida por unidade produzida"
          },
          "total_consumed": {
            "type": "number",
            "description": "Total consumido (quantity_per_unit \u00d7 produced_quantity)"
          }
        }
      },
      "default": [],
      "description": "Estrutura de produtos (Bill of Materials) \u2014 insumos/mat\u00e9ria-prima consumidos"
    },
    "parent_order_id": {
      "type": "string",
      "description": "ID da OP de origem (produ\u00e7\u00e3o multi-n\u00edvel \u2014 OP autom\u00e1tica de subproduto)"
    },
    "parent_order_number": {
      "type": "string",
      "description": "N\u00famero da OP de origem (cache)"
    },
    "emission_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o da OP (ISO)"
    },
    "start_date": {
      "type": "string",
      "description": "Data de in\u00edcio da produ\u00e7\u00e3o (ISO)"
    },
    "completion_date": {
      "type": "string",
      "description": "Data de conclus\u00e3o (ISO)"
    },
    "start_datetime": {
      "type": "string",
      "description": "Data e hora de in\u00edcio da produ\u00e7\u00e3o (apontamento \u2014 YYYY-MM-DDTHH:mm)"
    },
    "end_datetime": {
      "type": "string",
      "description": "Data e hora do t\u00e9rmino da produ\u00e7\u00e3o (apontamento \u2014 YYYY-MM-DDTHH:mm)"
    },
    "lunch_start": {
      "type": "string",
      "description": "Hora de in\u00edcio da parada para refei\u00e7\u00e3o (HH:MM) \u2014 abatida do tempo dispon\u00edvel"
    },
    "lunch_end": {
      "type": "string",
      "description": "Hora de retorno da refei\u00e7\u00e3o (HH:MM)"
    },
    "stops": {
      "type": "array",
      "default": [],
      "description": "Paradas de produ\u00e7\u00e3o do apontamento: mec\u00e2nicas, el\u00e9tricas ou operacionais \u2014 com equipamento parado, hor\u00e1rio (dentro do per\u00edodo de produ\u00e7\u00e3o), pessoas envolvidas, troca de pe\u00e7a, custo extra e observa\u00e7\u00f5es \u2014 base do c\u00e1lculo de efici\u00eancia e do custo extra da produ\u00e7\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "mecanica",
              "eletrica",
              "operacional"
            ],
            "description": "Motivo da parada: mecanica, eletrica ou operacional"
          },
          "equipment_id": {
            "type": "string",
            "description": "ID do equipamento que parou (ErpEquipment) \u2014 paradas mec\u00e2nicas e el\u00e9tricas"
          },
          "equipment_name": {
            "type": "string",
            "description": "Nome do equipamento que parou (cache)"
          },
          "start_time": {
            "type": "string",
            "description": "Data e hora de in\u00edcio da parada (YYYY-MM-DDTHH:mm)"
          },
          "end_time": {
            "type": "string",
            "description": "Data e hora de conclus\u00e3o da parada/retorno (YYYY-MM-DDTHH:mm)"
          },
          "people_count": {
            "type": "number",
            "default": 0,
            "description": "Quantidade de pessoas envolvidas na parada"
          },
          "replaced_part": {
            "type": "boolean",
            "default": false,
            "description": "Se foi necess\u00e1rio substituir pe\u00e7a"
          },
          "extra_cost": {
            "type": "number",
            "default": 0,
            "description": "Custo extra da parada (pe\u00e7a/m\u00e3o de obra) a agregar ao custo do produto produzido"
          },
          "notes": {
            "type": "string",
            "description": "Motivo da parada, pe\u00e7a substitu\u00edda e demais observa\u00e7\u00f5es"
          }
        }
      }
    },
    "extra_cost_total": {
      "type": "number",
      "default": 0,
      "description": "Custo extra total das paradas do apontamento \u2014 agregado ao custo de produ\u00e7\u00e3o na conclus\u00e3o da OP"
    },
    "produced_quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade efetivamente produzida"
    },
    "input_cost_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total dos insumos consumidos na produ\u00e7\u00e3o (custo m\u00e9dio \u2014 inclui perdas de insumos e custo extra das paradas)"
    },
    "output_unit_cost": {
      "type": "number",
      "default": 0,
      "description": "Custo unit\u00e1rio do produto produzido (custo total \u00f7 quantidade produzida) \u2014 usado na valora\u00e7\u00e3o da entrada do produto acabado no kardex"
    },
    "loss_items": {
      "type": "array",
      "default": [],
      "description": "Insumos considerados perda na conclus\u00e3o (produ\u00e7\u00e3o menor que a programada sem devolu\u00e7\u00e3o ao estoque) \u2014 o valor entra no custo de produ\u00e7\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 0
          },
          "value": {
            "type": "number",
            "default": 0,
            "description": "Valor da perda ao custo m\u00e9dio do insumo"
          }
        }
      }
    },
    "wip_items": {
      "type": "array",
      "default": [],
      "description": "Insumos deixados em processo (WIP) na conclus\u00e3o \u2014 sa\u00edram do estoque pela requisi\u00e7\u00e3o e permanecem em processo (n\u00e3o entram no custo de produ\u00e7\u00e3o)",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 0
          },
          "value": {
            "type": "number",
            "default": 0,
            "description": "Valor do insumo em processo ao custo m\u00e9dio"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "standby",
        "em_producao",
        "concluida",
        "cancelada"
      ],
      "default": "rascunho",
      "description": "Status: rascunho, standby (aguardando estoque p/ gerar solicita\u00e7\u00e3o ao almoxarifado), em_producao, concluida (estoque atualizado), cancelada"
    },
    "requisition_id": {
      "type": "string",
      "description": "ID da requisi\u00e7\u00e3o ao almoxarifado gerada (ErpWarehouseRequisition)"
    },
    "requisition_number": {
      "type": "string",
      "description": "N\u00famero da requisi\u00e7\u00e3o ao almoxarifado (cache)"
    },
    "complementary_requisition_id": {
      "type": "string",
      "description": "ID da requisi\u00e7\u00e3o complementar ao almoxarifado (ErpWarehouseRequisition) \u2014 gerada quando a quantidade produzida excede a planejada"
    },
    "complementary_requisition_number": {
      "type": "string",
      "description": "N\u00famero da requisi\u00e7\u00e3o complementar (cache)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "order_number",
    "output_product_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}