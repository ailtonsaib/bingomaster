{
  "name": "ErpCashMove",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "date": {
      "type": "string",
      "description": "Data (ISO)"
    },
    "type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "default": "saida"
    },
    "bank_account_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria (ErpBankAccount)"
    },
    "bank_name": {
      "type": "string",
      "description": "Conta (cache)"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento cont\u00e1bil (ErpAccountingEvent) \u2014 base do lan\u00e7amento: entrada banco D x evento C, sa\u00edda banco C x evento D"
    },
    "event_name": {
      "type": "string",
      "description": "Evento cont\u00e1bil (cache)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "description",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}