{
  "name": "ErpFiscalEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "entry_kind": {
      "type": "string",
      "enum": [
        "nf_entrada",
        "despesa"
      ],
      "default": "nf_entrada",
      "description": "Tipo da entrada: nf_entrada (nota de entrada com controle de estoque) ou despesa (despesa/servi\u00e7o sem controle de estoque)"
    },
    "nota_model": {
      "type": "string",
      "description": "55=NF-e, 65=NFC-e, NFSe=Nota Fiscal de Servi\u00e7o"
    },
    "nota_number": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "nota_series": {
      "type": "string",
      "description": "S\u00e9rie da nota"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso (NF-e)"
    },
    "issue_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o (ISO)"
    },
    "entry_date": {
      "type": "string",
      "description": "Data de entrada (ISO)"
    },
    "due_date": {
      "type": "string",
      "description": "Data de vencimento (financeiro/contas a pagar) (ISO)"
    },
    "installments": {
      "type": "array",
      "default": [],
      "description": "Parcelas de pagamento (digita\u00e7\u00e3o manual) \u2014 cada parcela gera uma conta a pagar no financeiro com seu vencimento e valor",
      "items": {
        "type": "object",
        "properties": {
          "due_date": {
            "type": "string",
            "description": "Vencimento da parcela (ISO)"
          },
          "amount": {
            "type": "number",
            "default": 0,
            "description": "Valor da parcela"
          }
        }
      }
    },
    "supplier_name": {
      "type": "string",
      "description": "Fornecedor/Emitente (cache)"
    },
    "supplier_cnpj": {
      "type": "string",
      "description": "CNPJ/CPF do emitente"
    },
    "supplier_uf": {
      "type": "string"
    },
    "nature_operation": {
      "type": "string"
    },
    "cfop": {
      "type": "string"
    },
    "total_products": {
      "type": "number",
      "default": 0
    },
    "total_nota": {
      "type": "number",
      "default": 0,
      "description": "Valor total da nota (vNF / ValorLiquidoNfse)"
    },
    "base_icms": {
      "type": "number",
      "default": 0,
      "description": "Base de c\u00e1lculo do ICMS (capa \u2014 deve fechar com a soma dos itens)"
    },
    "aliq_icms": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota do ICMS (capa, %)"
    },
    "aliq_reducao_icms": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota de redu\u00e7\u00e3o da base do ICMS (capa, %)"
    },
    "base_pis_cofins": {
      "type": "number",
      "default": 0,
      "description": "Base de c\u00e1lculo do PIS/COFINS (capa \u2014 deve fechar com a soma dos itens)"
    },
    "aliq_pis_cofins": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota do PIS/COFINS (capa, %)"
    },
    "pauta_pis_cofins": {
      "type": "number",
      "default": 0,
      "description": "Pauta do PIS/COFINS (capa, R$ por unidade \u2014 usada no lugar da al\u00edquota)"
    },
    "difal_value": {
      "type": "number",
      "default": 0,
      "description": "DIFAL total (capa \u2014 deve fechar com a soma dos itens)"
    },
    "total_icms": {
      "type": "number",
      "default": 0
    },
    "total_ipi": {
      "type": "number",
      "default": 0
    },
    "total_pis": {
      "type": "number",
      "default": 0
    },
    "total_cofins": {
      "type": "number",
      "default": 0
    },
    "dif_aliquota_value": {
      "type": "number",
      "default": 0,
      "description": "Valor do ICMS \u2014 diferen\u00e7a de al\u00edquota a recolher (contabilizado pela parametriza\u00e7\u00e3o da opera\u00e7\u00e3o)"
    },
    "despesas_value": {
      "type": "number",
      "default": 0,
      "description": "Despesas acess\u00f3rias da nota (vOutro/vSeg \u2014 frete, seguro, outros)"
    },
    "descontos_value": {
      "type": "number",
      "default": 0,
      "description": "Descontos da nota (vDesc)"
    },
    "ciap_curto_value": {
      "type": "number",
      "default": 0,
      "description": "ICMS do ativo imobilizado \u2014 CIAP curto prazo (at\u00e9 1 ano)"
    },
    "ciap_longo_value": {
      "type": "number",
      "default": 0,
      "description": "ICMS do ativo imobilizado \u2014 CIAP longo prazo (ap\u00f3s 1 ano)"
    },
    "icms_frete_value": {
      "type": "number",
      "default": 0,
      "description": "ICMS destacado sobre o frete (a creditar \u2014 conta ICMS Frete da parametriza\u00e7\u00e3o)"
    },
    "pis_frete_value": {
      "type": "number",
      "default": 0,
      "description": "PIS destacado sobre o frete (a creditar \u2014 conta PIS s/ Frete da parametriza\u00e7\u00e3o)"
    },
    "cofins_frete_value": {
      "type": "number",
      "default": 0,
      "description": "COFINS destacado sobre o frete (a creditar \u2014 conta COFINS s/ Frete da parametriza\u00e7\u00e3o)"
    },
    "freight": {
      "type": "object",
      "description": "Frete da entrada (CT-e/NF-e/NFS-e do frete importado) \u2014 o valor l\u00edquido comp\u00f5e o custo dos produtos e gera contas a pagar para a transportadora",
      "properties": {
        "doc_model": {
          "type": "string",
          "description": "Modelo do documento do frete (57=CT-e, 55=NF-e, NFSe)"
        },
        "doc_number": {
          "type": "string",
          "description": "N\u00famero do documento do frete"
        },
        "doc_series": {
          "type": "string",
          "description": "S\u00e9rie do documento do frete"
        },
        "chave_acesso": {
          "type": "string",
          "description": "Chave de acesso do documento do frete"
        },
        "issue_date": {
          "type": "string",
          "description": "Data de emiss\u00e3o do frete (ISO)"
        },
        "supplier_name": {
          "type": "string",
          "description": "Transportadora (cache)"
        },
        "supplier_cnpj": {
          "type": "string",
          "description": "CNPJ/CPF da transportadora"
        },
        "supplier_uf": {
          "type": "string",
          "description": "UF da transportadora \u2014 define o CFOP do frete"
        },
        "value": {
          "type": "number",
          "default": 0,
          "description": "Valor total do frete"
        },
        "icms_value": {
          "type": "number",
          "default": 0,
          "description": "ICMS destacado no frete (a creditar)"
        },
        "pis_value": {
          "type": "number",
          "default": 0,
          "description": "PIS destacado no frete (a creditar)"
        },
        "cofins_value": {
          "type": "number",
          "default": 0,
          "description": "COFINS destacado no frete (a creditar)"
        },
        "operation_id": {
          "type": "string",
          "description": "Opera\u00e7\u00e3o de entrada do frete (ErpOperation) \u2014 base do c\u00e1lculo dos impostos"
        },
        "operation_name": {
          "type": "string",
          "description": "Nome da opera\u00e7\u00e3o do frete (cache)"
        },
        "cfop": {
          "type": "string",
          "description": "CFOP do frete \u2014 mesma UF da empresa inicia com 1, fora da UF inicia com 2"
        },
        "journal_entry_id": {
          "type": "string",
          "description": "ID do lan\u00e7amento cont\u00e1bil do frete (ErpJournalEntry)"
        },
        "journal_entry_number": {
          "type": "string",
          "description": "N\u00famero do lan\u00e7amento cont\u00e1bil do frete (cache)"
        }
      }
    },
    "items": {
      "type": "array",
      "default": [],
      "description": "Itens da nota \u2014 os impostos por item (CST, base, al\u00edquota, redu\u00e7\u00e3o, pauta, valores) devem fechar com os totais da capa",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "ID do produto vinculado (ErpProduct)"
          },
          "product_code": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "cst_icms": {
            "type": "string",
            "description": "CST do ICMS do item"
          },
          "base_icms": {
            "type": "number",
            "default": 0,
            "description": "Base de c\u00e1lculo do ICMS do item"
          },
          "icms_rate": {
            "type": "number",
            "description": "Al\u00edquota do ICMS do item (%)"
          },
          "aliq_reducao_icms": {
            "type": "number",
            "default": 0,
            "description": "Al\u00edquota de redu\u00e7\u00e3o da base do ICMS do item (%)"
          },
          "icms_value": {
            "type": "number"
          },
          "difal_value": {
            "type": "number",
            "default": 0,
            "description": "DIFAL do item (ICMS interestadual a recuperar)"
          },
          "cst_pis": {
            "type": "string",
            "description": "CST do PIS do item"
          },
          "cst_cofins": {
            "type": "string",
            "description": "CST do COFINS do item"
          },
          "base_pis_cofins": {
            "type": "number",
            "default": 0,
            "description": "Base de c\u00e1lculo do PIS/COFINS do item"
          },
          "aliq_pis_cofins": {
            "type": "number",
            "default": 0,
            "description": "Al\u00edquota do PIS/COFINS do item (%)"
          },
          "pauta_pis_cofins": {
            "type": "number",
            "default": 0,
            "description": "Pauta do PIS/COFINS do item (R$ por unidade \u2014 usada no lugar da al\u00edquota)"
          },
          "ipi_value": {
            "type": "number"
          },
          "pis_value": {
            "type": "number"
          },
          "cofins_value": {
            "type": "number"
          }
        }
      }
    },
    "purchase_order_id": {
      "type": "string",
      "description": "ID da ordem de compra vinculada (ErpPurchaseOrder)"
    },
    "purchase_order_number": {
      "type": "string",
      "description": "N\u00famero da OC (cache)"
    },
    "po_total_value": {
      "type": "number",
      "default": 0,
      "description": "Valor da ordem de compra (cache) \u2014 base de compara\u00e7\u00e3o"
    },
    "value_diff": {
      "type": "number",
      "default": 0,
      "description": "Diferen\u00e7a total_nota \u2212 po_total_value"
    },
    "values_match": {
      "type": "boolean",
      "default": true,
      "description": "Se o total da nota fecha com o total da OC"
    },
    "operation_id": {
      "type": "string",
      "description": "ID da opera\u00e7\u00e3o de entrada (ErpOperation) \u2014 opcional"
    },
    "operation_name": {
      "type": "string"
    },
    "apportionments": {
      "type": "array",
      "default": [],
      "description": "Rateio herdado da ordem de compra ou informado manualmente \u2014 usado no lan\u00e7amento cont\u00e1bil",
      "items": {
        "type": "object",
        "properties": {
          "department_id": {
            "type": "string"
          },
          "department_name": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "account_code": {
            "type": "string"
          },
          "account_name": {
            "type": "string"
          },
          "rateio_type": {
            "type": "string",
            "enum": [
              "percent",
              "value"
            ],
            "default": "percent"
          },
          "percent": {
            "type": "number",
            "default": 0
          },
          "value": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "retentions": {
      "type": "array",
      "default": [],
      "description": "Reten\u00e7\u00f5es da nota (servi\u00e7o): IRRF, PIS, COFINS, CSLL, INSS, ISS \u2014 cada uma com tipo, valor e fornecedor destinat\u00e1rio",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "IRRF",
              "PIS",
              "COFINS",
              "CSLL",
              "INSS",
              "ISS"
            ]
          },
          "value": {
            "type": "number",
            "default": 0
          },
          "partner_id": {
            "type": "string"
          },
          "partner_name": {
            "type": "string"
          }
        }
      }
    },
    "net_value": {
      "type": "number",
      "default": 0,
      "description": "Valor l\u00edquido ao fornecedor (total_nota \u2212 soma das reten\u00e7\u00f5es)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovada",
        "nao_aprovada",
        "lancada"
      ],
      "default": "pendente",
      "description": "Status da entrada: pendente, aprovada, nao_aprovada, lancada (lan\u00e7amento cont\u00e1bil gerado)"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "nao_aplica",
        "aguardando_aprovacao",
        "aprovada",
        "reprovada"
      ],
      "default": "nao_aplica"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_date": {
      "type": "string"
    },
    "approval_obs": {
      "type": "string"
    },
    "journal_entry_id": {
      "type": "string",
      "description": "ID do lan\u00e7amento cont\u00e1bil gerado (ErpJournalEntry)"
    },
    "journal_entry_number": {
      "type": "string",
      "description": "N\u00famero do lan\u00e7amento (cache)"
    },
    "financeiro_gerado": {
      "type": "boolean",
      "default": false,
      "description": "Se o financeiro (contas a pagar) j\u00e1 foi gerado para esta entrada/despesa"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "nota_number",
    "total_nota"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}