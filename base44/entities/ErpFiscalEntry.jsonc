{
  "name": "ErpFiscalEntry",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "entry_kind": {
      "type": "string",
      "enum": [
        "nf_entrada",
        "despesa"
      ],
      "default": "nf_entrada",
      "description": "Tipo da entrada: nf_entrada (nota de entrada com controle de estoque) ou despesa (despesa/servi\u00e7o sem controle de estoque)"
    },
    "nota_model": {
      "type": "string",
      "description": "55=NF-e, 65=NFC-e, NFSe=Nota Fiscal de Servi\u00e7o"
    },
    "nota_number": {
      "type": "string",
      "description": "N\u00famero da nota fiscal"
    },
    "nota_series": {
      "type": "string",
      "description": "S\u00e9rie da nota"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso (NF-e)"
    },
    "issue_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o (ISO)"
    },
    "entry_date": {
      "type": "string",
      "description": "Data de entrada (ISO)"
    },
    "due_date": {
      "type": "string",
      "description": "Data de vencimento (financeiro/contas a pagar) (ISO)"
    },
    "installments": {
      "type": "array",
      "default": [],
      "description": "Parcelas de pagamento (digita\u00e7\u00e3o manual) \u2014 cada parcela gera uma conta a pagar no financeiro com seu vencimento e valor",
      "items": {
        "type": "object",
        "properties": {
          "due_date": {
            "type": "string",
            "description": "Vencimento da parcela (ISO)"
          },
          "amount": {
            "type": "number",
            "default": 0,
            "description": "Valor da parcela"
          }
        }
      }
    },
    "supplier_name": {
      "type": "string",
      "description": "Fornecedor/Emitente (cache)"
    },
    "supplier_cnpj": {
      "type": "string",
      "description": "CNPJ/CPF do emitente"
    },
    "supplier_uf": {
      "type": "string"
    },
    "nature_operation": {
      "type": "string"
    },
    "cfop": {
      "type": "string"
    },
    "total_products": {
      "type": "number",
      "default": 0
    },
    "total_nota": {
      "type": "number",
      "default": 0,
      "description": "Valor total da nota (vNF / ValorLiquidoNfse)"
    },
    "total_icms": {
      "type": "number",
      "default": 0
    },
    "total_ipi": {
      "type": "number",
      "default": 0
    },
    "total_pis": {
      "type": "number",
      "default": 0
    },
    "total_cofins": {
      "type": "number",
      "default": 0
    },
    "items": {
      "type": "array",
      "default": [],
      "description": "Itens da nota",
      "items": {
        "type": "object",
        "properties": {
          "product_code": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "cst_icms": {
            "type": "string"
          },
          "icms_rate": {
            "type": "number"
          },
          "icms_value": {
            "type": "number"
          },
          "ipi_value": {
            "type": "number"
          },
          "pis_value": {
            "type": "number"
          },
          "cofins_value": {
            "type": "number"
          }
        }
      }
    },
    "purchase_order_id": {
      "type": "string",
      "description": "ID da ordem de compra vinculada (ErpPurchaseOrder)"
    },
    "purchase_order_number": {
      "type": "string",
      "description": "N\u00famero da OC (cache)"
    },
    "po_total_value": {
      "type": "number",
      "default": 0,
      "description": "Valor da ordem de compra (cache) \u2014 base de compara\u00e7\u00e3o"
    },
    "value_diff": {
      "type": "number",
      "default": 0,
      "description": "Diferen\u00e7a total_nota \u2212 po_total_value"
    },
    "values_match": {
      "type": "boolean",
      "default": true,
      "description": "Se o total da nota fecha com o total da OC"
    },
    "operation_id": {
      "type": "string",
      "description": "ID da opera\u00e7\u00e3o de entrada (ErpOperation) \u2014 opcional"
    },
    "operation_name": {
      "type": "string"
    },
    "apportionments": {
      "type": "array",
      "default": [],
      "description": "Rateio herdado da ordem de compra ou informado manualmente \u2014 usado no lan\u00e7amento cont\u00e1bil",
      "items": {
        "type": "object",
        "properties": {
          "department_id": {
            "type": "string"
          },
          "department_name": {
            "type": "string"
          },
          "account_id": {
            "type": "string"
          },
          "account_code": {
            "type": "string"
          },
          "account_name": {
            "type": "string"
          },
          "rateio_type": {
            "type": "string",
            "enum": [
              "percent",
              "value"
            ],
            "default": "percent"
          },
          "percent": {
            "type": "number",
            "default": 0
          },
          "value": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "retentions": {
      "type": "array",
      "default": [],
      "description": "Reten\u00e7\u00f5es da nota (servi\u00e7o): IRRF, PIS, COFINS, CSLL, INSS, ISS \u2014 cada uma com tipo, valor e fornecedor destinat\u00e1rio",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "IRRF",
              "PIS",
              "COFINS",
              "CSLL",
              "INSS",
              "ISS"
            ]
          },
          "value": {
            "type": "number",
            "default": 0
          },
          "partner_id": {
            "type": "string"
          },
          "partner_name": {
            "type": "string"
          }
        }
      }
    },
    "net_value": {
      "type": "number",
      "default": 0,
      "description": "Valor l\u00edquido ao fornecedor (total_nota \u2212 soma das reten\u00e7\u00f5es)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovada",
        "nao_aprovada",
        "lancada"
      ],
      "default": "pendente",
      "description": "Status da entrada: pendente, aprovada, nao_aprovada, lancada (lan\u00e7amento cont\u00e1bil gerado)"
    },
    "approval_status": {
      "type": "string",
      "enum": [
        "nao_aplica",
        "aguardando_aprovacao",
        "aprovada",
        "reprovada"
      ],
      "default": "nao_aplica"
    },
    "approved_by_id": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_date": {
      "type": "string"
    },
    "approval_obs": {
      "type": "string"
    },
    "journal_entry_id": {
      "type": "string",
      "description": "ID do lan\u00e7amento cont\u00e1bil gerado (ErpJournalEntry)"
    },
    "journal_entry_number": {
      "type": "string",
      "description": "N\u00famero do lan\u00e7amento (cache)"
    },
    "financeiro_gerado": {
      "type": "boolean",
      "default": false,
      "description": "Se o financeiro (contas a pagar) j\u00e1 foi gerado para esta entrada/despesa"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "nota_number",
    "total_nota"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}