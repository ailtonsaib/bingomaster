{
  "name": "ErpReceivable",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta"
    },
    "customer_name": {
      "type": "string",
      "description": "Cliente"
    },
    "category": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "description": "Vencimento (ISO)"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "receipt_date": {
      "type": "string",
      "description": "Data de recebimento (ISO)"
    },
    "payment_method": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria utilizada na baixa (ErpBankAccount)"
    },
    "bank_account_name": {
      "type": "string",
      "description": "Conta banc\u00e1ria da baixa (cache)"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "recebido"
      ],
      "default": "aberto"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "description",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}