{
  "name": "PDVSale",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "operator_name": {
      "type": "string",
      "description": "Nome do operador"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente (opcional)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        }
      },
      "description": "Itens da venda",
      "default": []
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "description": "Subtotal"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto aplicado"
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Total da venda"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "credito",
        "debito",
        "pix",
        "voucher"
      ],
      "description": "Forma de pagamento"
    },
    "payment_amount": {
      "type": "number",
      "default": 0,
      "description": "Valor pago pelo cliente"
    },
    "change_amount": {
      "type": "number",
      "default": 0,
      "description": "Troco"
    },
    "status": {
      "type": "string",
      "enum": [
        "concluida",
        "cancelada"
      ],
      "default": "concluida",
      "description": "Status da venda"
    },
    "sale_date": {
      "type": "string",
      "description": "Data/hora da venda (ISO)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "total",
    "payment_method"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}