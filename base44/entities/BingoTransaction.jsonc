{
  "name": "BingoTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "game_id": {
      "type": "string",
      "description": "ID do jogo vinculado (opcional)"
    },
    "game_name": {
      "type": "string",
      "description": "Nome do jogo vinculado (cache)"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Tipo: receita (vendas) ou despesa"
    },
    "category": {
      "type": "string",
      "enum": [
        "venda_cartelas",
        "venda_ingressos",
        "doacao",
        "outra_receita",
        "papel",
        "impressao",
        "propaganda",
        "bebidas",
        "salgados",
        "alimentacao",
        "material_escritorio",
        "premios",
        "aluguel",
        "decoracao",
        "som_iluminacao",
        "transporte",
        "outra_despesa"
      ],
      "description": "Categoria da movimenta\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Valor total da movimenta\u00e7\u00e3o"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade (ex: n\u00ba de cartelas vendidas)"
    },
    "unit_price": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o unit\u00e1rio (ex: pre\u00e7o por cartela)"
    },
    "date": {
      "type": "string",
      "description": "Data da movimenta\u00e7\u00e3o (ISO)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "dinheiro",
        "pix",
        "cartao",
        "boleto",
        "transferencia"
      ],
      "description": "Forma de pagamento"
    },
    "supplier": {
      "type": "string",
      "description": "Fornecedor/estabelecimento (para despesas)"
    }
  },
  "required": [
    "user_email",
    "type",
    "category",
    "description",
    "amount"
  ]
}