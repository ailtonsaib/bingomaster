{
  "name": "ErpPartner",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "cliente",
        "fornecedor",
        "ambos"
      ],
      "default": "cliente",
      "description": "Tipo do parceiro: cliente, fornecedor ou ambos"
    },
    "document_type": {
      "type": "string",
      "enum": [
        "cpf",
        "cnpj"
      ],
      "description": "Tipo de documento"
    },
    "document": {
      "type": "string",
      "description": "CPF ou CNPJ (apenas n\u00fameros)"
    },
    "name": {
      "type": "string",
      "description": "Raz\u00e3o social (CNPJ) ou nome completo (CPF)"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia (CNPJ)"
    },
    "ie": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "im": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Municipal"
    },
    "cep": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "number": {
      "type": "string"
    },
    "district": {
      "type": "string",
      "description": "Bairro"
    },
    "city": {
      "type": "string",
      "description": "Munic\u00edpio"
    },
    "uf": {
      "type": "string"
    },
    "ibge_code": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "contact_person": {
      "type": "string",
      "description": "Pessoa de contato"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor respons\u00e1vel (ErpSalesTeam) \u2014 quando cliente"
    },
    "vendedor_name": {
      "type": "string",
      "description": "Nome do vendedor (cache)"
    },
    "channel_id": {
      "type": "string",
      "description": "ID do canal (ErpChannel) \u2014 quando cliente"
    },
    "channel_name": {
      "type": "string",
      "description": "Nome do canal (cache)"
    },
    "activity_sector_id": {
      "type": "string",
      "description": "ID do ramo de atividade (ErpActivitySector) \u2014 quando cliente"
    },
    "activity_sector_name": {
      "type": "string",
      "description": "Nome do ramo (cache)"
    },
    "rede_id": {
      "type": "string",
      "description": "ID da rede (ErpNetwork) \u2014 opcional, quando cliente"
    },
    "rede_name": {
      "type": "string",
      "description": "Nome da rede (cache)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "name",
    "partner_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}