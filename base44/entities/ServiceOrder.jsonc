{
  "name": "ServiceOrder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero da ordem de servi\u00e7o"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "em_andamento",
        "aguardando_pecas",
        "concluida",
        "entregue",
        "cancelada"
      ],
      "default": "aberta",
      "description": "Status: aberta, em_andamento, aguardando_pecas, concluida, entregue, cancelada"
    },
    "priority": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta"
      ],
      "default": "media",
      "description": "Prioridade da OS: baixa, media ou alta"
    },
    "client_id": {
      "type": "string",
      "description": "ID do cliente"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "client_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do cliente (cache)"
    },
    "client_phone": {
      "type": "string",
      "description": "Telefone do cliente (cache)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "ID do ve\u00edculo"
    },
    "vehicle_plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo (cache)"
    },
    "vehicle_brand": {
      "type": "string",
      "description": "Marca do ve\u00edculo (cache)"
    },
    "vehicle_model": {
      "type": "string",
      "description": "Modelo do ve\u00edculo (cache)"
    },
    "vehicle_year": {
      "type": "string",
      "description": "Ano do ve\u00edculo (cache)"
    },
    "vehicle_mileage": {
      "type": "number",
      "default": 0,
      "description": "Quilometragem na entrada do ve\u00edculo"
    },
    "service_type_id": {
      "type": "string",
      "description": "ID do tipo de servi\u00e7o selecionado"
    },
    "service_type_name": {
      "type": "string",
      "description": "Nome do tipo de servi\u00e7o (cache)"
    },
    "service_category": {
      "type": "string",
      "description": "Categoria do servi\u00e7o (motor, eletrica, suspensao, freios, ar_condicionado, transmissao, geral) \u2014 usada para filtrar mec\u00e2nicos compat\u00edveis",
      "default": "geral"
    },
    "mechanic_id": {
      "type": "string",
      "description": "ID do mec\u00e2nico respons\u00e1vel"
    },
    "mechanic_name": {
      "type": "string",
      "description": "Nome do mec\u00e2nico respons\u00e1vel (cache)"
    },
    "client_complaint": {
      "type": "string",
      "description": "Queixa / problema relatado pelo cliente"
    },
    "technical_diagnosis": {
      "type": "string",
      "description": "Diagn\u00f3stico t\u00e9cnico realizado pelo mec\u00e2nico"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "peca",
              "servico"
            ]
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_price": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number",
            "default": 0
          },
          "part_id": {
            "type": "string"
          },
          "part_code": {
            "type": "string"
          },
          "mechanic_id": {
            "type": "string"
          }
        }
      },
      "description": "Itens da OS (pe\u00e7as e servi\u00e7os)",
      "default": []
    },
    "parts_total": {
      "type": "number",
      "default": 0,
      "description": "Total de pe\u00e7as"
    },
    "labor_total": {
      "type": "number",
      "default": 0,
      "description": "Total de m\u00e3o de obra (servi\u00e7os)"
    },
    "discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto aplicado"
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Valor total da OS"
    },
    "scheduled_date": {
      "type": "string",
      "description": "Data prevista de conclus\u00e3o (ISO)"
    },
    "start_date": {
      "type": "string",
      "description": "Data de in\u00edcio do servi\u00e7o (ISO)"
    },
    "completion_date": {
      "type": "string",
      "description": "Data de conclus\u00e3o (ISO)"
    },
    "delivery_date": {
      "type": "string",
      "description": "Data de entrega ao cliente (ISO)"
    },
    "warranty_months": {
      "type": "number",
      "default": 0,
      "description": "Meses de garantia"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "parcial"
      ],
      "default": "pendente",
      "description": "Status do pagamento"
    },
    "payment_method": {
      "type": "string",
      "description": "Forma de pagamento (dinheiro, pix, cartao, prazo)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais"
    },
    "is_return": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 uma OS de retorno (garantia/rework) de um servi\u00e7o anterior"
    },
    "original_order_id": {
      "type": "string",
      "description": "ID da OS original (quando is_return=true)"
    },
    "original_order_number": {
      "type": "string",
      "description": "N\u00famero da OS original (cache, quando is_return=true)"
    },
    "original_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "part_id": {
            "type": "string"
          },
          "part_code": {
            "type": "string"
          },
          "mechanic_id": {
            "type": "string"
          }
        }
      },
      "description": "Itens herdados da OS original (refer\u00eancia \u2014 n\u00e3o geram financeiro)",
      "default": []
    },
    "last_edited_by_email": {
      "type": "string",
      "description": "Email do \u00faltimo usu\u00e1rio que editou a OS (para auditoria)"
    },
    "last_edited_by_name": {
      "type": "string",
      "description": "Nome do \u00faltimo usu\u00e1rio que editou a OS (para auditoria)"
    }
  },
  "required": [
    "user_email",
    "order_number",
    "client_name",
    "vehicle_brand",
    "vehicle_model"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}