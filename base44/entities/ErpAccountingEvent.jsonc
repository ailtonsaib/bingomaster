{
  "name": "ErpAccountingEvent",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "name": {
      "type": "string",
      "description": "Nome do evento (ex: FORNECEDORES)"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "cliente",
        "fornecedor"
      ],
      "default": "fornecedor",
      "description": "Tipo do evento: fornecedor (baixa de Contas a Pagar) ou cliente (baixa de Contas a Receber)"
    },
    "lines": {
      "type": "array",
      "default": [],
      "description": "Linhas do evento: tipo (d\u00e9bito/cr\u00e9dito), conta cont\u00e1bil e hist\u00f3rico padr\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "D",
              "C"
            ],
            "default": "D",
            "description": "Tipo: D (d\u00e9bito) ou C (cr\u00e9dito)"
          },
          "account_id": {
            "type": "string",
            "description": "ID da conta cont\u00e1bil (ErpChartAccount)"
          },
          "account_code": {
            "type": "string",
            "description": "C\u00f3digo da conta cont\u00e1bil (cache)"
          },
          "account_name": {
            "type": "string",
            "description": "Nome da conta cont\u00e1bil (cache)"
          },
          "history_id": {
            "type": "string",
            "description": "ID do hist\u00f3rico padr\u00e3o (ErpStandardHistory)"
          },
          "history_code": {
            "type": "string",
            "description": "C\u00f3digo do hist\u00f3rico padr\u00e3o (cache)"
          },
          "history_text": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o do hist\u00f3rico padr\u00e3o (cache)"
          }
        }
      }
    },
    "juros_1_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Juros 1 (ErpChartAccount) \u2014 D na baixa de fornecedor, C na baixa de cliente"
    },
    "juros_1_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Juros 1 (cache)"
    },
    "juros_1_account_name": {
      "type": "string",
      "description": "Nome da conta de Juros 1 (cache)"
    },
    "juros_2_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Juros 2 (ErpChartAccount) \u2014 D na baixa de fornecedor, C na baixa de cliente"
    },
    "juros_2_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Juros 2 (cache)"
    },
    "juros_2_account_name": {
      "type": "string",
      "description": "Nome da conta de Juros 2 (cache)"
    },
    "juros_3_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Juros 3 (ErpChartAccount) \u2014 D na baixa de fornecedor, C na baixa de cliente"
    },
    "juros_3_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Juros 3 (cache)"
    },
    "juros_3_account_name": {
      "type": "string",
      "description": "Nome da conta de Juros 3 (cache)"
    },
    "descontos_1_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Desconto 1 (ErpChartAccount) \u2014 C na baixa de fornecedor, D na baixa de cliente"
    },
    "descontos_1_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Desconto 1 (cache)"
    },
    "descontos_1_account_name": {
      "type": "string",
      "description": "Nome da conta de Desconto 1 (cache)"
    },
    "descontos_2_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Desconto 2 (ErpChartAccount) \u2014 C na baixa de fornecedor, D na baixa de cliente"
    },
    "descontos_2_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Desconto 2 (cache)"
    },
    "descontos_2_account_name": {
      "type": "string",
      "description": "Nome da conta de Desconto 2 (cache)"
    },
    "descontos_3_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Desconto 3 (ErpChartAccount) \u2014 C na baixa de fornecedor, D na baixa de cliente"
    },
    "descontos_3_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Desconto 3 (cache)"
    },
    "descontos_3_account_name": {
      "type": "string",
      "description": "Nome da conta de Desconto 3 (cache)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}