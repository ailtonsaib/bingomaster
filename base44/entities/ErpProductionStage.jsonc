{
  "name": "ErpProductionStage",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo da empresa)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da etapa de produ\u00e7\u00e3o"
    },
    "name": {
      "type": "string",
      "description": "Nome da etapa de produ\u00e7\u00e3o (ex: Montagem, Envase, Rotulagem, Embalagem)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da etapa de produ\u00e7\u00e3o"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a etapa est\u00e1 ativa"
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}