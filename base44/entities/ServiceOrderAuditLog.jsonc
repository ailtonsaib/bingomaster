{
  "name": "ServiceOrderAuditLog",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID da Ordem de Servi\u00e7o auditada"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero da OS (cache)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio da empresa (escopo)"
    },
    "changed_by_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "changed_by_name": {
      "type": "string",
      "description": "Nome do usu\u00e1rio que fez a altera\u00e7\u00e3o"
    },
    "changed_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Lista de campos financeiros alterados"
    },
    "old_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total anterior"
    },
    "new_total": {
      "type": "number",
      "default": 0,
      "description": "Valor total novo"
    },
    "old_discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto anterior"
    },
    "new_discount": {
      "type": "number",
      "default": 0,
      "description": "Desconto novo"
    },
    "old_parts_total": {
      "type": "number",
      "default": 0,
      "description": "Total de pe\u00e7as anterior"
    },
    "new_parts_total": {
      "type": "number",
      "default": 0,
      "description": "Total de pe\u00e7as novo"
    },
    "old_labor_total": {
      "type": "number",
      "default": 0,
      "description": "Total de m\u00e3o de obra anterior"
    },
    "new_labor_total": {
      "type": "number",
      "default": 0,
      "description": "Total de m\u00e3o de obra novo"
    },
    "old_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "part_id": {
            "type": "string"
          },
          "part_code": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Snapshot dos itens antes da altera\u00e7\u00e3o"
    },
    "new_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "part_id": {
            "type": "string"
          },
          "part_code": {
            "type": "string"
          }
        }
      },
      "default": [],
      "description": "Snapshot dos itens depois da altera\u00e7\u00e3o"
    },
    "old_status": {
      "type": "string",
      "description": "Status anterior da OS"
    },
    "new_status": {
      "type": "string",
      "description": "Status novo da OS"
    },
    "is_suspicious": {
      "type": "boolean",
      "default": false,
      "description": "Se a altera\u00e7\u00e3o de valor ocorreu ap\u00f3s a OS estar conclu\u00edda/entregue (poss\u00edvel m\u00e1 f\u00e9)"
    },
    "timestamp": {
      "type": "string",
      "description": "Data/hora da altera\u00e7\u00e3o (ISO)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o leg\u00edvel da altera\u00e7\u00e3o"
    }
  },
  "required": [
    "order_id",
    "user_email",
    "timestamp"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}