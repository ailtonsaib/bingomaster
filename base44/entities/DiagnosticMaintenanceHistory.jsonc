{
  "name": "DiagnosticMaintenanceHistory",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "vehicle_id": {
      "type": "string",
      "description": "ID do ve\u00edculo (DiagnosticVehicle)"
    },
    "client_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do cliente propriet\u00e1rio (cache)"
    },
    "client_name": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo (cache)"
    },
    "brand": {
      "type": "string",
      "description": "Marca do ve\u00edculo (cache)"
    },
    "model": {
      "type": "string",
      "description": "Modelo do ve\u00edculo (cache)"
    },
    "year": {
      "type": "string",
      "description": "Ano do ve\u00edculo (cache)"
    },
    "type": {
      "type": "string",
      "enum": [
        "troca_oleo",
        "servico",
        "revisao",
        "outro",
        "termo_responsabilidade"
      ],
      "default": "servico",
      "description": "Tipo de manuten\u00e7\u00e3o: troca_oleo, servico, revisao, outro ou termo_responsabilidade"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o/manuten\u00e7\u00e3o realizada"
    },
    "date": {
      "type": "string",
      "description": "Data da manuten\u00e7\u00e3o (ISO)"
    },
    "mileage": {
      "type": "number",
      "default": 0,
      "description": "Quilometragem do ve\u00edculo na data da manuten\u00e7\u00e3o"
    },
    "oil_viscosity": {
      "type": "string",
      "description": "Viscosidade do \u00f3leo (ex: 5W30) \u2014 apenas para troca_oleo"
    },
    "oil_filter_code": {
      "type": "string",
      "description": "C\u00f3digo do filtro de \u00f3leo \u2014 apenas para troca_oleo"
    },
    "next_oil_change_km": {
      "type": "number",
      "default": 0,
      "description": "KM previsto para pr\u00f3xima troca de \u00f3leo"
    },
    "service_order_id": {
      "type": "string",
      "description": "ID da OS vinculada (se originada de uma ordem de servi\u00e7o)"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero da OS vinculada (cache)"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "description": "Custo da manuten\u00e7\u00e3o"
    },
    "mechanic_name": {
      "type": "string",
      "description": "Nome do mec\u00e2nico respons\u00e1vel (cache)"
    },
    "declined_problem": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do problema que o cliente foi avisado e n\u00e3o quis executar (usado em termo_responsabilidade)"
    },
    "declined_recommendation": {
      "type": "string",
      "description": "Recomenda\u00e7\u00e3o t\u00e9cnica sobre o problema recusado e poss\u00edveis consequ\u00eancias (usado em termo_responsabilidade)"
    },
    "signed_document_url": {
      "type": "string",
      "description": "URL da foto do termo de responsabilidade assinado pelo cliente e mec\u00e2nico"
    },
    "term_date": {
      "type": "string",
      "description": "Data em que o termo de responsabilidade foi emitido (ISO)"
    }
  },
  "required": [
    "user_email",
    "type",
    "date"
  ]
}