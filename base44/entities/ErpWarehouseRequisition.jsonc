{
  "name": "ErpWarehouseRequisition",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo da empresa)"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero da requisi\u00e7\u00e3o ao almoxarifado (ex: REQ 001/2026)"
    },
    "production_order_id": {
      "type": "string",
      "description": "ID da ordem de produ\u00e7\u00e3o vinculada (ErpProductionOrder)"
    },
    "production_order_number": {
      "type": "string",
      "description": "N\u00famero da OP vinculada (cache)"
    },
    "finished_order_number": {
      "type": "string",
      "description": "N\u00famero da OP do produto acabado de origem (quando a requisi\u00e7\u00e3o pertence a uma OP de subproduto \u2014 cache da OP raiz)"
    },
    "finished_product_name": {
      "type": "string",
      "description": "Nome do produto acabado de origem da OP raiz (cache)"
    },
    "items": {
      "type": "array",
      "default": [],
      "description": "Insumos solicitados ao almoxarifado",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 0,
            "description": "Quantidade solicitada"
          },
          "stock_at_request": {
            "type": "number",
            "default": 0,
            "description": "Estoque dispon\u00edvel no momento da solicita\u00e7\u00e3o (cache)"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "atendida",
        "cancelada"
      ],
      "default": "pendente",
      "description": "Status: pendente, atendida, cancelada"
    },
    "request_date": {
      "type": "string",
      "description": "Data da solicita\u00e7\u00e3o (ISO)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}