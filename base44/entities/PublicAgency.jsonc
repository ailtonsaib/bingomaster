{
  "name": "PublicAgency",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "name": {
      "type": "string",
      "description": "Nome do \u00f3rg\u00e3o p\u00fablico (Prefeitura, Secretaria, Autarquia)"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ do \u00f3rg\u00e3o (apenas n\u00fameros)"
    },
    "contact_person": {
      "type": "string",
      "description": "Pessoa de contato (pregoeiro/ordenador)"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "description": "Email de contato"
    },
    "address": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "city": {
      "type": "string",
      "description": "Munic\u00edpio"
    },
    "uf": {
      "type": "string",
      "description": "UF"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o \u00f3rg\u00e3o est\u00e1 ativo"
    }
  },
  "required": [
    "user_email",
    "name"
  ]
}