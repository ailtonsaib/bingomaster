{
  "name": "ErpOperationAccounting",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "operation_id": {
      "type": "string",
      "description": "ID da opera\u00e7\u00e3o de entrada (ErpOperation)"
    },
    "operation_name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o (cache)"
    },
    "lines": {
      "type": "array",
      "default": [],
      "description": "Contas cont\u00e1beis parametrizadas para o lan\u00e7amento da entrada fiscal: fornecedores (C, total da nota), impostos a recuperar (D) e contas opcionais (C). O rateio da entrada sempre gera o d\u00e9bito do valor l\u00edquido nas contas do pr\u00f3prio rateio",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "fornecedores",
              "icms",
              "pis",
              "cofins",
              "ipi",
              "dif_aliquota",
              "frete"
            ],
            "description": "Linha: fornecedores (C total), icms/pis/cofins/ipi (D a recuperar), dif_aliquota/frete (C opcionais)"
          },
          "type": {
            "type": "string",
            "enum": [
              "D",
              "C"
            ],
            "description": "Tipo: D (d\u00e9bito) ou C (cr\u00e9dito)"
          },
          "label": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o da linha (ex: FORNECEDORES, ICMS A RECUP)"
          },
          "account_id": {
            "type": "string",
            "description": "ID da conta cont\u00e1bil (ErpChartAccount anal\u00edtica)"
          },
          "account_code": {
            "type": "string",
            "description": "C\u00f3digo da conta cont\u00e1bil (cache)"
          },
          "account_name": {
            "type": "string",
            "description": "Nome da conta cont\u00e1bil (cache)"
          },
          "history_id": {
            "type": "string",
            "description": "ID do hist\u00f3rico padr\u00e3o (ErpStandardHistory) \u2014 opcional"
          },
          "history_code": {
            "type": "string",
            "description": "C\u00f3digo do hist\u00f3rico padr\u00e3o (cache)"
          },
          "history_text": {
            "type": "string",
            "description": "Descri\u00e7\u00e3o do hist\u00f3rico padr\u00e3o (cache)"
          }
        }
      }
    }
  },
  "required": [
    "user_email",
    "operation_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}