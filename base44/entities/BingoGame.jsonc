{
  "name": "BingoGame",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do jogo de bingo"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "in_progress",
        "finished"
      ],
      "default": "waiting",
      "description": "Status do jogo"
    },
    "drawn_numbers": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "N\u00fameros j\u00e1 sorteados"
    },
    "max_number": {
      "type": "number",
      "default": 75,
      "description": "N\u00famero m\u00e1ximo (ex: 75 ou 90)"
    },
    "prizes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "awarded": {
            "type": "boolean"
          },
          "awarded_card_id": {
            "type": "string",
            "description": "ID da cartela vencedora"
          },
          "awarded_card_number": {
            "type": "number",
            "description": "N\u00famero da cartela vencedora"
          },
          "awarded_player_name": {
            "type": "string",
            "description": "Nome do comprador da cartela vencedora"
          },
          "pedra_maior": {
            "type": "number",
            "description": "N\u00famero da pedra maior (desempate entre m\u00faltiplos vencedores)"
          },
          "awarded_won_at_draw": {
            "type": "number",
            "description": "N\u00famero sorteado que completou o bingo da cartela vencedora"
          }
        }
      },
      "description": "Pr\u00eamios do jogo (at\u00e9 5)"
    },
    "event_location": {
      "type": "string",
      "description": "Local do evento (ex: nome do sal\u00e3o)"
    },
    "event_address": {
      "type": "string",
      "description": "Endere\u00e7o do evento (rua, n\u00famero, bairro)"
    },
    "event_date": {
      "type": "string",
      "description": "Data e hora do evento (ISO string)"
    },
    "event_price": {
      "type": "string",
      "description": "Valor da cartela/evento"
    },
    "event_treats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Guloseimas e comes e bebes dispon\u00edveis no evento"
    },
    "card_image_url": {
      "type": "string",
      "description": "URL da imagem que aparece nas cartelas impressas (logo/\u00edcone)"
    },
    "card_bg_image_url": {
      "type": "string",
      "description": "URL da imagem de fundo das cartelas impressas"
    },
    "draw_type": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical",
        "diagonal",
        "full"
      ],
      "default": "horizontal",
      "description": "Tipo de sorteio selecionado (horizontal, vertical, diagonal, full=cartela cheia)"
    },
    "card_filter": {
      "type": "string",
      "enum": [
        "all",
        "validated"
      ],
      "default": "validated",
      "description": "Quais cartelas participam do sorteio: all (todas) ou validated (apenas validadas)"
    }
  },
  "required": [
    "name"
  ]
}