{
  "name": "BingoCard",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "ID do jogo de bingo associado"
    },
    "card_identifier": {
      "type": "string",
      "description": "Identificador \u00fanico leg\u00edvel da cartela (ex: CARD-001)"
    },
    "card_number": {
      "type": "number",
      "description": "N\u00famero sequencial da cartela dentro do jogo"
    },
    "player_name": {
      "type": "string",
      "description": "Nome do jogador/dono da cartela"
    },
    "player_phone": {
      "type": "string",
      "description": "Telefone do jogador"
    },
    "player_city": {
      "type": "string",
      "description": "Cidade do jogador"
    },
    "player_state": {
      "type": "string",
      "description": "Estado do jogador"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor que vendeu esta cartela"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor que vendeu esta cartela (para exibi\u00e7\u00e3o r\u00e1pida)"
    },
    "chances": {
      "type": "number",
      "enum": [
        1,
        2,
        3
      ],
      "default": 1,
      "description": "N\u00famero de chances: 1 (\u00fanica), 2 (dupla) ou 3 (tripla)"
    },
    "exported_date": {
      "type": "string",
      "description": "Data em que a cartela foi exportada pelo vendedor (ISO string). Vazio/null = n\u00e3o exportada."
    },
    "payment_receipt_url": {
      "type": "string",
      "description": "URL da imagem do comprovante de pagamento"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid"
      ],
      "default": "paid",
      "description": "Status do pagamento: pending = aguardando confirma\u00e7\u00e3o, paid = pago e confirmado"
    },
    "is_validated": {
      "type": "boolean",
      "default": false,
      "description": "Indica se esta cartela est\u00e1 habilitada para concorrer aos pr\u00eamios no sorteio"
    },
    "grid_1a": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Primeira chance - grid 1 (20 n\u00fameros)"
    },
    "grid_1b": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Primeira chance - grid 2 (20 n\u00fameros)"
    },
    "grid_1c": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Primeira chance - grid 3 (20 n\u00fameros)"
    },
    "grid_2a": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Segunda chance - grid 1 (20 n\u00fameros)"
    },
    "grid_2b": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Segunda chance - grid 2 (20 n\u00fameros)"
    },
    "grid_2c": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Segunda chance - grid 3 (20 n\u00fameros)"
    },
    "grid_3a": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Terceira chance - grid 1 (20 n\u00fameros)"
    },
    "grid_3b": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Terceira chance - grid 2 (20 n\u00fameros)"
    },
    "grid_3c": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Terceira chance - grid 3 (20 n\u00fameros)"
    },
    "grid_1": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Legacy: primeira cartela (compatibilidade)"
    },
    "grid_2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Legacy: segunda cartela (compatibilidade)"
    },
    "grid_3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Legacy: terceira cartela (compatibilidade)"
    },
    "won_prizes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prize_index": {
            "type": "number"
          },
          "prize_name": {
            "type": "string"
          },
          "won_at_draw": {
            "type": "number"
          },
          "won_at": {
            "type": "string"
          }
        }
      },
      "description": "Pr\u00eamios ganhos por esta cartela"
    },
    "is_winner": {
      "type": "boolean",
      "default": false,
      "description": "Indica se esta cartela j\u00e1 ganhou algum pr\u00eamio"
    }
  },
  "required": [
    "game_id",
    "player_name"
  ]
}