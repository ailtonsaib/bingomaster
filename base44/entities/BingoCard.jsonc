{
  "name": "BingoCard",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "ID do jogo de bingo associado"
    },
    "card_identifier": {
      "type": "string",
      "description": "Identificador \u00fanico leg\u00edvel da cartela (ex: CARD-001)"
    },
    "card_number": {
      "type": "number",
      "description": "N\u00famero sequencial da cartela dentro do jogo"
    },
    "player_name": {
      "type": "string",
      "description": "Nome do jogador/dono da cartela"
    },
    "player_phone": {
      "type": "string",
      "description": "Telefone do jogador"
    },
    "player_city": {
      "type": "string",
      "description": "Cidade do jogador"
    },
    "player_state": {
      "type": "string",
      "description": "Estado do jogador"
    },
    "chances": {
      "type": "number",
      "enum": [
        1,
        2
      ],
      "default": 1,
      "description": "Dificuldade de chances: 1 (normal) ou 2 (dupla chance)"
    },
    "exported_date": {
      "type": "string",
      "description": "Data em que a cartela foi exportada pelo vendedor (ISO string). Vazio/null = n\u00e3o exportada."
    },
    "payment_receipt_url": {
      "type": "string",
      "description": "URL da imagem do comprovante de pagamento"
    },
    "grid_1a": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Primeira chance - grid 1 (25 n\u00fameros, centro=0)"
    },
    "grid_1b": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Primeira chance - grid 2 (25 n\u00fameros, centro=0)"
    },
    "grid_1c": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Primeira chance - grid 3 (25 n\u00fameros, centro=0)"
    },
    "grid_2a": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Segunda chance - grid 1 (25 n\u00fameros, centro=0)"
    },
    "grid_2b": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Segunda chance - grid 2 (25 n\u00fameros, centro=0)"
    },
    "grid_2c": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Segunda chance - grid 3 (25 n\u00fameros, centro=0)"
    },
    "grid_1": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Legacy: primeira cartela (compatibilidade)"
    },
    "grid_2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Legacy: segunda cartela (compatibilidade)"
    },
    "won_prizes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prize_index": {
            "type": "number"
          },
          "prize_name": {
            "type": "string"
          },
          "won_at_draw": {
            "type": "number"
          },
          "won_at": {
            "type": "string"
          }
        }
      },
      "description": "Pr\u00eamios ganhos por esta cartela"
    },
    "is_winner": {
      "type": "boolean",
      "default": false,
      "description": "Indica se esta cartela j\u00e1 ganhou algum pr\u00eamio"
    }
  },
  "required": [
    "game_id",
    "player_name"
  ]
}