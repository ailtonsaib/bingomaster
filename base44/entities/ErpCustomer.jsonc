{
  "name": "ErpCustomer",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "name": {
      "type": "string",
      "description": "Nome / Raz\u00e3o social"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "district": {
      "type": "string",
      "description": "Bairro (usado na NF-e de sa\u00edda)"
    },
    "city": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio (usado na NF-e de sa\u00edda)"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor respons\u00e1vel (ErpSalesTeam)"
    },
    "vendedor_name": {
      "type": "string",
      "description": "Vendedor respons\u00e1vel (cache)"
    },
    "channel_id": {
      "type": "string",
      "description": "ID do canal de vendas (ErpChannel)"
    },
    "channel_name": {
      "type": "string",
      "description": "Canal de vendas (cache)"
    },
    "activity_sector_id": {
      "type": "string",
      "description": "ID do ramo de atividade (ErpActivitySector)"
    },
    "activity_sector_name": {
      "type": "string",
      "description": "Ramo de atividade (cache)"
    },
    "network_id": {
      "type": "string",
      "description": "ID da rede (ErpNetwork)"
    },
    "network_name": {
      "type": "string",
      "description": "Rede (cache)"
    },
    "payment_form": {
      "type": "string",
      "enum": [
        "a_vista",
        "cheque",
        "boleto",
        "promissoria",
        "cartao_credito",
        "cartao_debito",
        "pix",
        "transferencia",
        "outros"
      ],
      "description": "Forma de pagamento padr\u00e3o do cliente"
    },
    "payment_term": {
      "type": "string",
      "enum": [
        "a_vista",
        "7 dias",
        "14 dias",
        "21 dias",
        "28 dias",
        "30 dias",
        "45 dias",
        "60 dias",
        "15/30 dias",
        "15/30/45 dias",
        "21/28/35/42 dias",
        "30/60 dias",
        "30/60/90 dias",
        "30/45/60/75/90 dias"
      ],
      "description": "Condi\u00e7\u00e3o de pagamento padr\u00e3o do cliente"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}