{
  "name": "ErpCustomer",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "name": {
      "type": "string",
      "description": "Nome / Raz\u00e3o social"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "delivery_address": {
      "type": "string",
      "description": "Endere\u00e7o de entrega (quando diferente do endere\u00e7o cadastrado)"
    },
    "district": {
      "type": "string",
      "description": "Bairro (usado na NF-e de sa\u00edda)"
    },
    "city": {
      "type": "string"
    },
    "uf": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio (usado na NF-e de sa\u00edda)"
    },
    "vendedor_id": {
      "type": "string",
      "description": "ID do vendedor respons\u00e1vel (ErpSalesTeam)"
    },
    "vendedor_name": {
      "type": "string",
      "description": "Vendedor respons\u00e1vel (cache)"
    },
    "channel_id": {
      "type": "string",
      "description": "ID do canal de vendas (ErpChannel)"
    },
    "channel_name": {
      "type": "string",
      "description": "Canal de vendas (cache)"
    },
    "activity_sector_id": {
      "type": "string",
      "description": "ID do ramo de atividade (ErpActivitySector)"
    },
    "activity_sector_name": {
      "type": "string",
      "description": "Ramo de atividade (cache)"
    },
    "network_id": {
      "type": "string",
      "description": "ID da rede (ErpNetwork)"
    },
    "network_name": {
      "type": "string",
      "description": "Rede (cache)"
    },
    "price_table_id": {
      "type": "string",
      "description": "ID da tabela de pre\u00e7o padr\u00e3o do cliente (ErpPriceTable)"
    },
    "price_table_name": {
      "type": "string",
      "description": "Tabela de pre\u00e7o padr\u00e3o do cliente (cache)"
    },
    "payment_form": {
      "type": "string",
      "enum": [
        "a_vista",
        "cheque",
        "boleto",
        "promissoria",
        "cartao_credito",
        "cartao_debito",
        "pix",
        "transferencia",
        "outros"
      ],
      "description": "Forma de pagamento padr\u00e3o do cliente"
    },
    "payment_term": {
      "type": "string",
      "description": "Condi\u00e7\u00e3o de pagamento padr\u00e3o do cliente (texto livre \u2014 ex.: \u00c0 vista, 30/60/90 dias ou uma condi\u00e7\u00e3o personalizada)"
    },
    "contribuinte": {
      "type": "boolean",
      "default": false,
      "description": "Se o cliente \u00e9 contribuinte do ICMS (possui inscri\u00e7\u00e3o estadual)"
    },
    "ie": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual do cliente (obrigat\u00f3ria quando contribuinte \u2014 usada na NF-e de sa\u00edda)"
    },
    "suframa": {
      "type": "string",
      "description": "N\u00famero SUFRAMA do cliente (zona franca \u2014 usada na NF-e de sa\u00edda)"
    },
    "visit_frequency": {
      "type": "string",
      "enum": [
        "semanal",
        "bissemanal",
        "quinzenal",
        "mensal"
      ],
      "default": "semanal",
      "description": "Frequ\u00eancia de visita do vendedor ao cliente (estat\u00edsticas de vendas): semanal, bissemanal (2\u00d7 por semana), quinzenal ou mensal"
    },
    "visit_day_1": {
      "type": "string",
      "enum": [
        "segunda",
        "terca",
        "quarta",
        "quinta",
        "sexta",
        "sabado"
      ],
      "description": "Dia da visita do vendedor (semanal, quinzenal, mensal ou 1\u00ba dia da bissemanal)"
    },
    "visit_day_2": {
      "type": "string",
      "enum": [
        "segunda",
        "terca",
        "quarta",
        "quinta",
        "sexta",
        "sabado"
      ],
      "description": "Segundo dia da visita (frequ\u00eancia bissemanal \u2014 ex.: segunda e quinta, ter\u00e7a e sexta, quarta e s\u00e1bado)"
    },
    "visit_status": {
      "type": "string",
      "enum": [
        "pendente",
        "vendido",
        "sem_venda"
      ],
      "default": "pendente",
      "description": "Resultado da \u00faltima visita no App do Vendedor: vendido (cliente fez pedido \u2014 marcado em verde), sem_venda (visitado sem venda \u2014 marcado em amarelo) ou pendente"
    },
    "no_sale_reason": {
      "type": "string",
      "description": "Motivo informado pelo vendedor quando a visita n\u00e3o gerou venda"
    },
    "last_visit_date": {
      "type": "string",
      "description": "Data da \u00faltima visita/registro do vendedor (ISO)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}