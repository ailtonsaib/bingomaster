{
  "name": "PDVCustomer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do cliente"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ"
    },
    "ie": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "email": {
      "type": "string",
      "description": "Email"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero"
    },
    "complement": {
      "type": "string",
      "description": "Complemento"
    },
    "district": {
      "type": "string",
      "description": "Bairro"
    },
    "city": {
      "type": "string",
      "description": "Munic\u00edpio"
    },
    "uf": {
      "type": "string",
      "description": "UF (sigla do estado)"
    },
    "ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio (7 d\u00edgitos)"
    },
    "user_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "user_email"
  ]
}