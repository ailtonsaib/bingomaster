{
  "name": "TicketPriority",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome da prioridade"
    },
    "level": {
      "type": "number",
      "description": "N\u00edvel (1=baixa, 5=cr\u00edtica)"
    },
    "color": {
      "type": "string",
      "description": "Cor (red, orange, yellow, blue, green)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se est\u00e1 ativa"
    }
  },
  "required": [
    "name",
    "level"
  ]
}