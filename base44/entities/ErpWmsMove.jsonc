{
  "name": "ErpWmsMove",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "move_type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida",
        "transferencia"
      ],
      "description": "Tipo de movimenta\u00e7\u00e3o: entrada, saida ou transferencia (entre endere\u00e7os)"
    },
    "product_id": {
      "type": "string",
      "description": "ID do produto (ErpProduct)"
    },
    "product_code": {
      "type": "string",
      "description": "C\u00f3digo do produto (cache)"
    },
    "product_name": {
      "type": "string",
      "description": "Nome do produto (cache)"
    },
    "unit": {
      "type": "string",
      "description": "Unidade de medida (cache)"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade movimentada"
    },
    "warehouse_id": {
      "type": "string",
      "description": "ID do armaz\u00e9m da movimenta\u00e7\u00e3o (origem na sa\u00edda, destino na entrada)"
    },
    "warehouse_name": {
      "type": "string",
      "description": "Nome do armaz\u00e9m (cache)"
    },
    "location_id": {
      "type": "string",
      "description": "ID do endere\u00e7o (origem na sa\u00edda, destino na entrada)"
    },
    "location_code": {
      "type": "string",
      "description": "C\u00f3digo do endere\u00e7o (cache)"
    },
    "target_location_id": {
      "type": "string",
      "description": "ID do endere\u00e7o de destino (apenas transfer\u00eancia)"
    },
    "target_location_code": {
      "type": "string",
      "description": "C\u00f3digo do endere\u00e7o de destino (cache \u2014 transfer\u00eancia)"
    },
    "lot": {
      "type": "string",
      "description": "Lote do produto"
    },
    "fabricacao_date": {
      "type": "string",
      "description": "Data de fabrica\u00e7\u00e3o do lote (ISO) \u2014 informada no recebimento da NF"
    },
    "expiry_date": {
      "type": "string",
      "description": "Data de validade do lote (ISO) \u2014 controle FIFO/FEFO"
    },
    "document": {
      "type": "string",
      "description": "Documento de origem (NF, pedido, requisi\u00e7\u00e3o)"
    },
    "operator_name": {
      "type": "string",
      "description": "Usu\u00e1rio que realizou a bipagem da movimenta\u00e7\u00e3o (exibido no relat\u00f3rio bipado x previsto)"
    },
    "move_date": {
      "type": "string",
      "description": "Data da movimenta\u00e7\u00e3o (ISO)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "move_type",
    "product_id",
    "quantity"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}