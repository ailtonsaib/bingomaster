{
  "name": "PDVOperation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do modelo de opera\u00e7\u00e3o"
    },
    "operation_type": {
      "type": "string",
      "enum": [
        "entrada",
        "saida"
      ],
      "description": "Tipo de opera\u00e7\u00e3o: entrada ou sa\u00edda"
    },
    "cfop_default": {
      "type": "string",
      "description": "CFOP padr\u00e3o da opera\u00e7\u00e3o (ex: 1102, 5102)"
    },
    "nature_operation": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o (ex: Venda de mercadoria)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/observa\u00e7\u00f5es da opera\u00e7\u00e3o"
    },
    "user_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a opera\u00e7\u00e3o est\u00e1 ativa"
    }
  },
  "required": [
    "name",
    "operation_type",
    "user_email"
  ]
}