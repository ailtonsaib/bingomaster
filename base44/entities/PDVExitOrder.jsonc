{
  "name": "PDVExitOrder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "customer_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "customer_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do cliente (cache)"
    },
    "customer_ie": {
      "type": "string",
      "description": "IE do cliente (cache)"
    },
    "customer_uf": {
      "type": "string",
      "description": "UF do cliente (cache)"
    },
    "customer_city": {
      "type": "string",
      "description": "Munic\u00edpio do cliente (cache)"
    },
    "customer_ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio do cliente (cache)"
    },
    "customer_cep": {
      "type": "string",
      "description": "CEP do cliente (cache)"
    },
    "customer_address": {
      "type": "string",
      "description": "Endere\u00e7o do cliente (cache)"
    },
    "customer_number": {
      "type": "string",
      "description": "N\u00famero do endere\u00e7o do cliente (cache)"
    },
    "customer_district": {
      "type": "string",
      "description": "Bairro do cliente (cache)"
    },
    "buyer_type": {
      "type": "string",
      "enum": [
        "consumidor_final",
        "revendedor",
        "distribuidor"
      ],
      "default": "consumidor_final",
      "description": "Tipo de comprador: consumidor_final, revendedor (varejista) ou distribuidor \u2014 afeta c\u00e1lculo de PIS/COFINS em produtos bif\u00e1sicos (Lei 13.097)"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero interno do pedido"
    },
    "order_date": {
      "type": "string",
      "description": "Data do pedido (ISO)"
    },
    "cfop": {
      "type": "string",
      "description": "CFOP principal da opera\u00e7\u00e3o de sa\u00edda"
    },
    "nature_operation": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o (ex: Venda de mercadoria)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "origin": {
            "type": "number"
          },
          "monofasic": {
            "type": "boolean",
            "default": false
          },
          "tax_regime": {
            "type": "string"
          },
          "product_category": {
            "type": "string"
          },
          "csosn": {
            "type": "string"
          },
          "cst_icms": {
            "type": "string"
          },
          "icms_rate": {
            "type": "number"
          },
          "icms_value": {
            "type": "number"
          },
          "cst_ipi": {
            "type": "string"
          },
          "ipi_rate": {
            "type": "number"
          },
          "ipi_value": {
            "type": "number"
          },
          "cst_pis": {
            "type": "string"
          },
          "pis_rate": {
            "type": "number"
          },
          "pis_value": {
            "type": "number"
          },
          "cst_cofins": {
            "type": "string"
          },
          "cofins_rate": {
            "type": "number"
          },
          "cofins_value": {
            "type": "number"
          }
        }
      },
      "description": "Itens do pedido de sa\u00edda",
      "default": []
    },
    "total_products": {
      "type": "number",
      "default": 0,
      "description": "Total de produtos"
    },
    "total_icms": {
      "type": "number",
      "default": 0,
      "description": "Total de ICMS"
    },
    "total_ipi": {
      "type": "number",
      "default": 0,
      "description": "Total de IPI"
    },
    "total_pis": {
      "type": "number",
      "default": 0,
      "description": "Total de PIS"
    },
    "total_cofins": {
      "type": "number",
      "default": 0,
      "description": "Total de COFINS"
    },
    "total_nota": {
      "type": "number",
      "default": 0,
      "description": "Total da nota fiscal"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "emitida",
        "cancelada"
      ],
      "default": "rascunho",
      "description": "Status do pedido: rascunho, emitida (NF-e gerada), cancelada"
    },
    "nfe_model": {
      "type": "string",
      "enum": [
        "55",
        "65"
      ],
      "default": "55",
      "description": "Modelo do documento fiscal emitido: 55 (NF-e) ou 65 (NFC-e)"
    },
    "nfe_number": {
      "type": "string",
      "description": "N\u00famero da NF-e gerada"
    },
    "nfe_series": {
      "type": "string",
      "description": "S\u00e9rie da NF-e"
    },
    "nfe_key": {
      "type": "string",
      "description": "Chave de acesso da NF-e"
    },
    "nfe_xml": {
      "type": "string",
      "description": "XML da NF-e gerada"
    },
    "nfe_issue_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o da NF-e (ISO)"
    },
    "nfe_protocol": {
      "type": "string",
      "description": "Protocolo de autoriza\u00e7\u00e3o da NF-e (nProt retornado pela SEFAZ)"
    },
    "nfe_status": {
      "type": "string",
      "description": "Status da transmiss\u00e3o na SEFAZ (cStat + xMotivo)"
    },
    "nfe_auth_date": {
      "type": "string",
      "description": "Data de autoriza\u00e7\u00e3o da NF-e (ISO, dhRecbto)"
    },
    "nfe_environment": {
      "type": "string",
      "description": "Ambiente usado na transmiss\u00e3o: 1=Produ\u00e7\u00e3o, 2=Homologa\u00e7\u00e3o"
    },
    "payment_method": {
      "type": "string",
      "description": "Forma de pagamento (0=vista, 1=prazo)"
    },
    "due_date": {
      "type": "string",
      "description": "Data de vencimento (previs\u00e3o de recebimento) (ISO)"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "aberto",
        "recebido"
      ],
      "default": "aberto",
      "description": "Status do recebimento: aberto (a receber) ou recebido"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "customer_name",
    "total_nota"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}