{
  "name": "PDVExitOrder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "customer_id": {
      "type": "string",
      "description": "ID do cliente vinculado"
    },
    "customer_name": {
      "type": "string",
      "description": "Nome do cliente (cache)"
    },
    "customer_cpf_cnpj": {
      "type": "string",
      "description": "CPF/CNPJ do cliente (cache)"
    },
    "customer_ie": {
      "type": "string",
      "description": "IE do cliente (cache)"
    },
    "customer_uf": {
      "type": "string",
      "description": "UF do cliente (cache)"
    },
    "customer_city": {
      "type": "string",
      "description": "Munic\u00edpio do cliente (cache)"
    },
    "customer_ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio do cliente (cache)"
    },
    "customer_cep": {
      "type": "string",
      "description": "CEP do cliente (cache)"
    },
    "customer_address": {
      "type": "string",
      "description": "Endere\u00e7o do cliente (cache)"
    },
    "customer_number": {
      "type": "string",
      "description": "N\u00famero do endere\u00e7o do cliente (cache)"
    },
    "customer_district": {
      "type": "string",
      "description": "Bairro do cliente (cache)"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero interno do pedido"
    },
    "order_date": {
      "type": "string",
      "description": "Data do pedido (ISO)"
    },
    "cfop": {
      "type": "string",
      "description": "CFOP principal da opera\u00e7\u00e3o de sa\u00edda"
    },
    "nature_operation": {
      "type": "string",
      "description": "Natureza da opera\u00e7\u00e3o (ex: Venda de mercadoria)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_code": {
            "type": "string"
          },
          "barcode": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "ncm": {
            "type": "string"
          },
          "cfop": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "origin": {
            "type": "number"
          },
          "monofasic": {
            "type": "boolean",
            "default": false
          },
          "csosn": {
            "type": "string"
          },
          "cst_icms": {
            "type": "string"
          },
          "icms_rate": {
            "type": "number"
          },
          "icms_value": {
            "type": "number"
          },
          "cst_ipi": {
            "type": "string"
          },
          "ipi_rate": {
            "type": "number"
          },
          "ipi_value": {
            "type": "number"
          },
          "cst_pis": {
            "type": "string"
          },
          "pis_rate": {
            "type": "number"
          },
          "pis_value": {
            "type": "number"
          },
          "cst_cofins": {
            "type": "string"
          },
          "cofins_rate": {
            "type": "number"
          },
          "cofins_value": {
            "type": "number"
          }
        }
      },
      "description": "Itens do pedido de sa\u00edda",
      "default": []
    },
    "total_products": {
      "type": "number",
      "default": 0,
      "description": "Total de produtos"
    },
    "total_icms": {
      "type": "number",
      "default": 0,
      "description": "Total de ICMS"
    },
    "total_ipi": {
      "type": "number",
      "default": 0,
      "description": "Total de IPI"
    },
    "total_pis": {
      "type": "number",
      "default": 0,
      "description": "Total de PIS"
    },
    "total_cofins": {
      "type": "number",
      "default": 0,
      "description": "Total de COFINS"
    },
    "total_nota": {
      "type": "number",
      "default": 0,
      "description": "Total da nota fiscal"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "emitida",
        "cancelada"
      ],
      "default": "rascunho",
      "description": "Status do pedido: rascunho, emitida (NF-e gerada), cancelada"
    },
    "nfe_number": {
      "type": "string",
      "description": "N\u00famero da NF-e gerada"
    },
    "nfe_series": {
      "type": "string",
      "description": "S\u00e9rie da NF-e"
    },
    "nfe_key": {
      "type": "string",
      "description": "Chave de acesso da NF-e"
    },
    "nfe_xml": {
      "type": "string",
      "description": "XML da NF-e gerada"
    },
    "nfe_issue_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o da NF-e (ISO)"
    },
    "payment_method": {
      "type": "string",
      "description": "Forma de pagamento (0=vista, 1=prazo)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "customer_name",
    "total_nota"
  ]
}