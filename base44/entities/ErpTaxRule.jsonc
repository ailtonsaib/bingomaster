{
  "name": "ErpTaxRule",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "operation_id": {
      "type": "string",
      "description": "ID da opera\u00e7\u00e3o vinculada (ErpOperation)"
    },
    "operation_name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o (cache)"
    },
    "operation_type": {
      "type": "string",
      "description": "Tipo da opera\u00e7\u00e3o (cache: entrada/saida)"
    },
    "cfop": {
      "type": "string",
      "description": "CFOP da opera\u00e7\u00e3o (cache)"
    },
    "ncm": {
      "type": "string",
      "description": "NCM espec\u00edfico (opcional \u2014 se vazio, regra geral da opera\u00e7\u00e3o)"
    },
    "description": {
      "type": "string"
    },
    "cst_icms": {
      "type": "string",
      "description": "CST do ICMS"
    },
    "icms_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota ICMS (%)"
    },
    "icms_reduction_base": {
      "type": "number",
      "default": 100,
      "description": "Percentual de base do ICMS (%). 100 = base integral"
    },
    "fcp_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota FCP (%)"
    },
    "cst_pis": {
      "type": "string"
    },
    "pis_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota PIS (%)"
    },
    "pis_reduction_base": {
      "type": "number",
      "default": 100
    },
    "cst_cofins": {
      "type": "string"
    },
    "cofins_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota COFINS (%)"
    },
    "cofins_reduction_base": {
      "type": "number",
      "default": 100
    },
    "cst_ipi": {
      "type": "string"
    },
    "ipi_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota IPI (%)"
    },
    "ipi_reduction_base": {
      "type": "number",
      "default": 100
    },
    "cst_cbs": {
      "type": "string",
      "description": "CST do CBS (reforma tribut\u00e1ria)"
    },
    "cbs_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota CBS \u2014 Contribui\u00e7\u00e3o sobre Bens e Servi\u00e7os (%)"
    },
    "cbs_reduction_base": {
      "type": "number",
      "default": 100
    },
    "cst_ibs": {
      "type": "string",
      "description": "CST do IBS (reforma tribut\u00e1ria)"
    },
    "ibs_rate": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota IBS \u2014 Imposto sobre Bens e Servi\u00e7os (%)"
    },
    "ibs_reduction_base": {
      "type": "number",
      "default": 100
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "operation_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}