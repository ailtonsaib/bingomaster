{
  "name": "ErpAssetStructure",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo da estrutura patrimonial"
    },
    "name": {
      "type": "string",
      "description": "Nome da estrutura (ex: M\u00e1quinas, Ve\u00edculos, Im\u00f3veis, M\u00f3veis e Utens\u00edlios, Inform\u00e1tica)"
    },
    "depreciation_rate": {
      "type": "number",
      "default": 0,
      "description": "Taxa de deprecia\u00e7\u00e3o padr\u00e3o da estrutura (% a.a.)"
    },
    "useful_life_years": {
      "type": "number",
      "default": 0,
      "description": "Vida \u00fatil padr\u00e3o (anos) \u2014 0 = n\u00e3o aplica"
    },
    "deprec_expense_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Despesa de Deprecia\u00e7\u00e3o (ErpChartAccount) \u2014 d\u00e9bito no lan\u00e7amento da deprecia\u00e7\u00e3o"
    },
    "deprec_expense_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Despesa de Deprecia\u00e7\u00e3o (cache)"
    },
    "deprec_expense_account_name": {
      "type": "string",
      "description": "Nome da conta de Despesa de Deprecia\u00e7\u00e3o (cache)"
    },
    "deprec_accum_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de Deprecia\u00e7\u00e3o Acumulada (ErpChartAccount) \u2014 cr\u00e9dito no lan\u00e7amento da deprecia\u00e7\u00e3o"
    },
    "deprec_accum_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de Deprecia\u00e7\u00e3o Acumulada (cache)"
    },
    "deprec_accum_account_name": {
      "type": "string",
      "description": "Nome da conta de Deprecia\u00e7\u00e3o Acumulada (cache)"
    },
    "ciap_debit_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de cr\u00e9dito CIAP \u2014 ICMS a Recuperar/Outros Cr\u00e9ditos (ErpChartAccount) \u2014 d\u00e9bito no lan\u00e7amento da apropria\u00e7\u00e3o mensal do CIAP"
    },
    "ciap_debit_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de cr\u00e9dito CIAP (cache)"
    },
    "ciap_debit_account_name": {
      "type": "string",
      "description": "Nome da conta de cr\u00e9dito CIAP (cache)"
    },
    "ciap_credit_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil de CIAP \u2014 ICMS do Ativo Permanente (ErpChartAccount) \u2014 cr\u00e9dito no lan\u00e7amento da apropria\u00e7\u00e3o mensal do CIAP"
    },
    "ciap_credit_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de CIAP (cache)"
    },
    "ciap_credit_account_name": {
      "type": "string",
      "description": "Nome da conta de CIAP (cache)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}