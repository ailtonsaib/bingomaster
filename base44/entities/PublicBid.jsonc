{
  "name": "PublicBid",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador"
    },
    "bid_number": {
      "type": "string",
      "description": "N\u00famero do preg\u00e3o/licita\u00e7\u00e3o (ex: PE 001/2026)"
    },
    "modality": {
      "type": "string",
      "enum": [
        "pregao_eletronico",
        "pregao_presencial",
        "concorrencia",
        "tomada_precos",
        "convite",
        "dispensa",
        "inexigibilidade"
      ],
      "default": "pregao_eletronico",
      "description": "Modalidade de licita\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "publicado",
        "em_andamento",
        "julgamento",
        "homologado",
        "empenhado",
        "entregue",
        "cancelado"
      ],
      "default": "rascunho",
      "description": "Status do preg\u00e3o"
    },
    "agency_id": {
      "type": "string",
      "description": "ID do \u00f3rg\u00e3o p\u00fablico (PublicAgency)"
    },
    "agency_name": {
      "type": "string",
      "description": "Nome do \u00f3rg\u00e3o (cache)"
    },
    "object_description": {
      "type": "string",
      "description": "Objeto da licita\u00e7\u00e3o (descri\u00e7\u00e3o resumida)"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "reference_price": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "Itens do preg\u00e3o com pre\u00e7o de refer\u00eancia"
    },
    "opening_date": {
      "type": "string",
      "description": "Data de abertura das propostas (ISO)"
    },
    "closing_date": {
      "type": "string",
      "description": "Data limite para propostas (ISO)"
    },
    "winner_supplier_id": {
      "type": "string",
      "description": "ID do fornecedor vencedor"
    },
    "winner_supplier_name": {
      "type": "string",
      "description": "Nome do fornecedor vencedor (cache)"
    },
    "total_value": {
      "type": "number",
      "default": 0,
      "description": "Valor total do preg\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "bid_number",
    "modality",
    "object_description"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}