{
  "name": "ErpPayable",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da conta"
    },
    "beneficiary": {
      "type": "string",
      "description": "Fornecedor/benefici\u00e1rio"
    },
    "category": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "description": "Vencimento (ISO)"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "payment_date": {
      "type": "string",
      "description": "Data de pagamento (ISO)"
    },
    "payment_method": {
      "type": "string"
    },
    "bank_account_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria utilizada na baixa (ErpBankAccount)"
    },
    "bank_account_name": {
      "type": "string",
      "description": "Conta banc\u00e1ria da baixa (cache)"
    },
    "event_id": {
      "type": "string",
      "description": "ID do evento cont\u00e1bil da baixa (ErpAccountingEvent) \u2014 base do lan\u00e7amento cont\u00e1bil: banco x fornecedor, juros e descontos"
    },
    "event_name": {
      "type": "string",
      "description": "Evento cont\u00e1bil da baixa (cache)"
    },
    "settled_value": {
      "type": "number",
      "default": 0,
      "description": "Valor efetivamente pago na baixa (com manuten\u00e7\u00e3o de juros/descontos)"
    },
    "juros_1": {
      "type": "number",
      "default": 0,
      "description": "Juros da baixa \u2014 campo 1"
    },
    "juros_2": {
      "type": "number",
      "default": 0,
      "description": "Juros da baixa \u2014 campo 2"
    },
    "juros_3": {
      "type": "number",
      "default": 0,
      "description": "Juros da baixa \u2014 campo 3"
    },
    "descontos_1": {
      "type": "number",
      "default": 0,
      "description": "Descontos da baixa \u2014 campo 1"
    },
    "descontos_2": {
      "type": "number",
      "default": 0,
      "description": "Descontos da baixa \u2014 campo 2"
    },
    "descontos_3": {
      "type": "number",
      "default": 0,
      "description": "Descontos da baixa \u2014 campo 3"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberto",
        "pago"
      ],
      "default": "aberto"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "description",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}