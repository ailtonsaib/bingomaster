{
  "name": "Setting",
  "type": "object",
  "properties": {
    "brand_name": {
      "type": "string",
      "enum": [
        "BINGO",
        "SORTE",
        "AJUDA"
      ],
      "default": "BINGO",
      "description": "Nome da marca exibido no app e nas cartelas impressas (cabe\u00e7alho das colunas)"
    },
    "regulation": {
      "type": "string",
      "description": "Texto do regulamento do bingo para impress\u00e3o opcional junto \u00e0s cartelas"
    }
  },
  "required": [
    "brand_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}