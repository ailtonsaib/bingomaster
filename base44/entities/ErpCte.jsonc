{
  "name": "ErpCte",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "doc_model": {
      "type": "string",
      "description": "Modelo do documento (57=CT-e, 55=NF-e, NFSe)"
    },
    "doc_number": {
      "type": "string",
      "description": "N\u00famero do documento do frete"
    },
    "doc_series": {
      "type": "string",
      "description": "S\u00e9rie do documento"
    },
    "chave_acesso": {
      "type": "string",
      "description": "Chave de acesso do documento"
    },
    "issue_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o (ISO)"
    },
    "supplier_name": {
      "type": "string",
      "description": "Transportadora (cache)"
    },
    "supplier_cnpj": {
      "type": "string",
      "description": "CNPJ/CPF da transportadora"
    },
    "supplier_uf": {
      "type": "string",
      "description": "UF da transportadora"
    },
    "value": {
      "type": "number",
      "default": 0,
      "description": "Valor total do CT-e"
    },
    "base_icms": {
      "type": "number",
      "default": 0,
      "description": "Base de c\u00e1lculo do ICMS do frete"
    },
    "aliq_icms": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota do ICMS do frete (%)"
    },
    "icms_value": {
      "type": "number",
      "default": 0,
      "description": "ICMS destacado no frete (a creditar)"
    },
    "base_pis_cofins": {
      "type": "number",
      "default": 0,
      "description": "Base de c\u00e1lculo do PIS/COFINS do frete"
    },
    "aliq_pis": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota do PIS do frete (%)"
    },
    "aliq_cofins": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota do COFINS do frete (%)"
    },
    "cst_pis": {
      "type": "string",
      "description": "CST do PIS do frete"
    },
    "cst_cofins": {
      "type": "string",
      "description": "CST do COFINS do frete"
    },
    "pis_value": {
      "type": "number",
      "default": 0,
      "description": "PIS destacado no frete (a creditar)"
    },
    "cofins_value": {
      "type": "number",
      "default": 0,
      "description": "COFINS destacado no frete (a creditar)"
    },
    "operation_id": {
      "type": "string",
      "description": "Opera\u00e7\u00e3o de entrada do frete (ErpOperation)"
    },
    "operation_name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o do frete (cache)"
    },
    "cfop": {
      "type": "string",
      "description": "CFOP do frete \u2014 mesma UF da empresa inicia com 1, fora da UF inicia com 2"
    },
    "due_date": {
      "type": "string",
      "description": "Vencimento do pagamento do frete (ISO) \u2014 gera a conta a pagar da transportadora no financeiro"
    },
    "net_value": {
      "type": "number",
      "default": 0,
      "description": "Valor l\u00edquido do frete (deduzidos ICMS/PIS/COFINS) rateado entre as notas vinculadas compondo o custo dos produtos"
    },
    "links": {
      "type": "array",
      "default": [],
      "description": "Notas vinculadas ao CT-e \u2014 o valor l\u00edquido \u00e9 rateado proporcionalmente ao valor dos itens de cada nota",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "entrada",
              "venda"
            ],
            "description": "entrada = NF de entrada (ErpFiscalEntry) | venda = pedido de venda (ErpSalesOrder)"
          },
          "id": {
            "type": "string",
            "description": "ID da nota vinculada"
          },
          "number": {
            "type": "string",
            "description": "N\u00famero da nota (cache)"
          },
          "name": {
            "type": "string",
            "description": "Fornecedor (entrada) ou cliente (venda) (cache)"
          },
          "total": {
            "type": "number",
            "default": 0,
            "description": "Valor dos itens da nota (base do rateio)"
          },
          "share_value": {
            "type": "number",
            "default": 0,
            "description": "Parcela do frete l\u00edquido atribu\u00edda \u00e0 nota"
          }
        }
      }
    },
    "financeiro_gerado": {
      "type": "boolean",
      "default": false,
      "description": "Se a conta a pagar da transportadora j\u00e1 foi gerada"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "doc_number",
    "value"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}