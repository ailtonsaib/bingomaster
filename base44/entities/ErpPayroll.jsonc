{
  "name": "ErpPayroll",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "employee_id": {
      "type": "string",
      "description": "ID do funcion\u00e1rio (ErpEmployee)"
    },
    "employee_name": {
      "type": "string",
      "description": "Nome do funcion\u00e1rio (cache)"
    },
    "employee_cpf": {
      "type": "string",
      "description": "CPF do funcion\u00e1rio (cache)"
    },
    "job_title": {
      "type": "string",
      "description": "Cargo (cache)"
    },
    "department_name": {
      "type": "string",
      "description": "Departamento (cache)"
    },
    "month": {
      "type": "number",
      "description": "M\u00eas de compet\u00eancia (1-12)"
    },
    "year": {
      "type": "number",
      "description": "Ano de compet\u00eancia"
    },
    "payroll_type": {
      "type": "string",
      "enum": [
        "normal",
        "ferias",
        "decimo_terceiro",
        "primeira_parcela",
        "segunda_parcela",
        "rescisao"
      ],
      "default": "normal",
      "description": "Tipo: normal, ferias, decimo_terceiro, primeira_parcela, segunda_parcela, rescisao"
    },
    "rubricas": {
      "type": "array",
      "default": [],
      "description": "Linhas da folha (rubricas com valor)",
      "items": {
        "type": "object",
        "properties": {
          "rubric_id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "default": 0
          },
          "inc_inss": {
            "type": "boolean"
          },
          "inc_irrf": {
            "type": "boolean"
          },
          "inc_fgts": {
            "type": "boolean"
          },
          "inc_13": {
            "type": "boolean"
          }
        }
      }
    },
    "base_inss": {
      "type": "number",
      "default": 0
    },
    "base_irrf": {
      "type": "number",
      "default": 0
    },
    "base_fgts": {
      "type": "number",
      "default": 0
    },
    "base_13": {
      "type": "number",
      "default": 0
    },
    "inss_value": {
      "type": "number",
      "default": 0,
      "description": "INSS descontado do empregado"
    },
    "irrf_value": {
      "type": "number",
      "default": 0,
      "description": "IRRF descontado"
    },
    "fgts_value": {
      "type": "number",
      "default": 0,
      "description": "FGTS depositado (n\u00e3o descontado)"
    },
    "salario_familia_value": {
      "type": "number",
      "default": 0
    },
    "dependent_count": {
      "type": "number",
      "default": 0
    },
    "vacation_days": {
      "type": "number",
      "default": 0,
      "description": "Dias de f\u00e9rias gozados"
    },
    "vacation_start": {
      "type": "string"
    },
    "vacation_end": {
      "type": "string"
    },
    "abono_pecuniario": {
      "type": "boolean",
      "default": false,
      "description": "Convers\u00e3o de 10 dias em abono (1/3 isento)"
    },
    "ferias_um_terco": {
      "type": "number",
      "default": 0,
      "description": "1/3 constitucional sobre f\u00e9rias"
    },
    "decimo_months": {
      "type": "number",
      "default": 12,
      "description": "Meses trabalhados para o 13\u00ba (1-12)"
    },
    "employer_inss": {
      "type": "number",
      "default": 0,
      "description": "INSS patronal"
    },
    "employer_fgts": {
      "type": "number",
      "default": 0
    },
    "employer_sat": {
      "type": "number",
      "default": 0
    },
    "employer_terceiros": {
      "type": "number",
      "default": 0
    },
    "employer_total": {
      "type": "number",
      "default": 0,
      "description": "Total de encargos do empregador"
    },
    "gross_provents": {
      "type": "number",
      "default": 0,
      "description": "Total de proventos"
    },
    "gross_salary": {
      "type": "number",
      "default": 0,
      "description": "Sal\u00e1rio bruto (legado/compat)"
    },
    "total_discounts": {
      "type": "number",
      "default": 0,
      "description": "Total de descontos"
    },
    "discounts": {
      "type": "number",
      "default": 0,
      "description": "Total descontos (legado/compat)"
    },
    "net_salary": {
      "type": "number",
      "default": 0,
      "description": "Sal\u00e1rio l\u00edquido"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "pago",
        "fechada"
      ],
      "default": "pendente"
    },
    "payment_date": {
      "type": "string",
      "description": "Data de pagamento (ISO)"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "user_email",
    "employee_name",
    "month",
    "year"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}