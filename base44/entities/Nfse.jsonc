{
  "name": "Nfse",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio (escopo da empresa)"
    },
    "service_order_id": {
      "type": "string",
      "description": "ID da ordem de servi\u00e7o de origem"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero da OS de origem (cache)"
    },
    "rps_number": {
      "type": "string",
      "description": "N\u00famero do RPS (Recibo Provis\u00f3rio de Servi\u00e7o)"
    },
    "rps_series": {
      "type": "string",
      "description": "S\u00e9rie do RPS"
    },
    "emission_date": {
      "type": "string",
      "description": "Data de emiss\u00e3o do RPS (ISO)"
    },
    "prestador_cnpj": {
      "type": "string",
      "description": "CNPJ do prestador (14 d\u00edgitos)"
    },
    "prestador_im": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Municipal do prestador"
    },
    "prestador_razao": {
      "type": "string",
      "description": "Raz\u00e3o social do prestador (cache)"
    },
    "prestador_ibge": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio do prestador"
    },
    "prestador_city": {
      "type": "string",
      "description": "Munic\u00edpio do prestador (cache)"
    },
    "prestador_uf": {
      "type": "string",
      "description": "UF do prestador (cache)"
    },
    "tomador_doc": {
      "type": "string",
      "description": "CPF/CNPJ do tomador (apenas d\u00edgitos)"
    },
    "tomador_name": {
      "type": "string",
      "description": "Nome/raz\u00e3o social do tomador"
    },
    "service_code": {
      "type": "string",
      "description": "Item da lista de servi\u00e7o (c\u00f3digo municipal)"
    },
    "service_discriminacao": {
      "type": "string",
      "description": "Discrimina\u00e7\u00e3o do servi\u00e7o prestado"
    },
    "valor_servicos": {
      "type": "number",
      "default": 0,
      "description": "Valor dos servi\u00e7os"
    },
    "valor_deducoes": {
      "type": "number",
      "default": 0,
      "description": "Valor das dedu\u00e7\u00f5es"
    },
    "base_calculo": {
      "type": "number",
      "default": 0,
      "description": "Base de c\u00e1lculo do ISS (valor servi\u00e7os - dedu\u00e7\u00f5es)"
    },
    "aliquota": {
      "type": "number",
      "default": 0,
      "description": "Al\u00edquota do ISS (%)"
    },
    "valor_iss": {
      "type": "number",
      "default": 0,
      "description": "Valor do ISS calculado"
    },
    "iss_retido": {
      "type": "boolean",
      "default": false,
      "description": "Se o ISS foi retido pelo tomador"
    },
    "valor_liquido": {
      "type": "number",
      "default": 0,
      "description": "Valor l\u00edquido da NFS-e"
    },
    "total_nota": {
      "type": "number",
      "default": 0,
      "description": "Valor total da NFS-e"
    },
    "rps_xml": {
      "type": "string",
      "description": "XML do RPS (Abrasf) assinado, pronto para transmiss\u00e3o"
    },
    "nfse_number": {
      "type": "string",
      "description": "N\u00famero da NFS-e retornado pela prefeitura"
    },
    "nfse_protocol": {
      "type": "string",
      "description": "Protocolo de autoriza\u00e7\u00e3o da prefeitura"
    },
    "nfse_status": {
      "type": "string",
      "description": "Status da transmiss\u00e3o (cStat/mensagem da prefeitura)"
    },
    "nfse_xml": {
      "type": "string",
      "description": "XML da NFS-e autorizada retornado pela prefeitura"
    },
    "nfse_auth_date": {
      "type": "string",
      "description": "Data de autoriza\u00e7\u00e3o pela prefeitura (ISO)"
    },
    "ambiente": {
      "type": "string",
      "description": "Ambiente: 1=Produ\u00e7\u00e3o, 2=Homologa\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "emitida",
        "cancelada"
      ],
      "default": "rascunho",
      "description": "Status: rascunho (RPS gerado, aguardando transmiss\u00e3o), emitida (autorizada pela prefeitura), cancelada"
    }
  },
  "required": [
    "user_email",
    "rps_number",
    "emission_date",
    "total_nota"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}