{
  "name": "ErpChartAccount",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo/m\u00e1scara da conta (ex: 1.1.01.01.0001) \u2014 \u00fanico por empresa"
    },
    "name": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o (nome) da conta"
    },
    "referencia": {
      "type": "string",
      "description": "Refer\u00eancia num\u00e9rica da conta (ex: 1000)"
    },
    "grau": {
      "type": "number",
      "default": 1,
      "description": "Grau/n\u00edvel hier\u00e1rquico da conta (1-5)"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "ativo",
        "passivo",
        "patrimonio_liquido",
        "receita",
        "despesa",
        "compensacao"
      ],
      "description": "Identifica\u00e7\u00e3o de n\u00edveis: ativo, passivo, patrimonio_liquido, receita, despesa, compensacao"
    },
    "nature": {
      "type": "string",
      "enum": [
        "devedora",
        "credora"
      ],
      "description": "Natureza da conta"
    },
    "classificacao": {
      "type": "string",
      "description": "Classifica\u00e7\u00e3o da conta"
    },
    "conta_encerramento": {
      "type": "string",
      "enum": [
        "nao_aplica",
        "sim",
        "nao"
      ],
      "default": "nao_aplica",
      "description": "Conta de encerramento"
    },
    "classificacao_industrial": {
      "type": "string",
      "enum": [
        "nao_aplica",
        "insumos",
        "mao_de_obra",
        "ggf"
      ],
      "default": "nao_aplica",
      "description": "Classifica\u00e7\u00e3o industrial (custo de produ\u00e7\u00e3o)"
    },
    "estrutura_custo": {
      "type": "string",
      "enum": [
        "nao_aplica",
        "direto",
        "indireto"
      ],
      "default": "nao_aplica",
      "description": "Estrutura de custo"
    },
    "concilia_lancamentos": {
      "type": "boolean",
      "default": true,
      "description": "Se concilia lan\u00e7amentos"
    },
    "conta_orcamentaria": {
      "type": "boolean",
      "default": false,
      "description": "Se \u00e9 conta or\u00e7ament\u00e1ria"
    },
    "accepts_entries": {
      "type": "boolean",
      "default": true,
      "description": "Tipo: true = ANAL\u00cdTICA (aceita lan\u00e7amentos), false = SINT\u00c9TICA (agrupadora)"
    },
    "parent_id": {
      "type": "string",
      "description": "ID da conta pai (n\u00edvel superior)"
    },
    "parent_code": {
      "type": "string",
      "description": "C\u00f3digo da conta pai (n\u00edvel superior) \u2014 cache"
    },
    "referential_code": {
      "type": "string",
      "description": "C\u00f3digo da conta referencial vinculada (Plano Referencial Receita/ECD) \u2014 obrigat\u00f3rio para anal\u00edticas; null para sint\u00e9ticas"
    },
    "referential_name": {
      "type": "string",
      "description": "Nome da conta referencial (cache)"
    },
    "usa_centro_custo": {
      "type": "boolean",
      "default": false,
      "description": "Se usa centro de custo"
    },
    "participates_production_cost": {
      "type": "boolean",
      "default": false,
      "description": "Se a conta participa dos custos de produ\u00e7\u00e3o"
    },
    "production_cost_type": {
      "type": "string",
      "enum": [
        "insumos",
        "mao_de_obra",
        "ggf"
      ],
      "description": "Tipo de custo de produ\u00e7\u00e3o: insumos, mao_de_obra ou ggf"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "code",
    "name",
    "account_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}