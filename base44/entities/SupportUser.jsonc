{
  "name": "SupportUser",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio"
    },
    "email": {
      "type": "string",
      "description": "Email (login)"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash da senha"
    },
    "company_id": {
      "type": "string",
      "description": "ID da empresa vinculada"
    },
    "company_name": {
      "type": "string",
      "description": "Nome da empresa"
    },
    "role": {
      "type": "string",
      "enum": [
        "system_admin",
        "company_admin",
        "master_agent",
        "admin",
        "agent",
        "requester"
      ],
      "default": "agent",
      "description": "Papel: system_admin (acesso total), company_admin (acesso total do CNPJ), master_agent (atendente master que recebe e distribui chamados), admin (legacy = company_admin), agent (atendente), requester (solicitante)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o usu\u00e1rio est\u00e1 ativo"
    },
    "last_login_at": {
      "type": "string",
      "description": "Data/hora do \u00faltimo login (ISO)"
    },
    "must_change_password": {
      "type": "boolean",
      "default": false,
      "description": "Se o usu\u00e1rio deve trocar a senha no pr\u00f3ximo acesso (ap\u00f3s recupera\u00e7\u00e3o por email)"
    }
  },
  "required": [
    "name",
    "email",
    "password_hash",
    "company_id"
  ]
}