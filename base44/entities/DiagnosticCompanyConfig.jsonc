    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social da oficina"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ (apenas n\u00fameros)"
    },
    "ie": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "logo_url": {
      "type": "string",
      "description": "URL da logo da oficina"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero"
    },
    "district": {
      "type": "string",
      "description": "Bairro"
    },
    "city": {
      "type": "string",
      "description": "Munic\u00edpio"
    },
    "uf": {
      "type": "string",
      "description": "UF"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "description": "Email de contato"
    },
    "admin_email": {
      "type": "string",
      "description": "Email do administrador da empresa que ter\u00e1 acesso ao sistema"
    },
    "admin_name": {
      "type": "string",
      "description": "Nome do administrador da empresa"
    },
    "access_granted": {
      "type": "boolean",
