{
  "name": "DiagnosticCompanyConfig",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social da oficina"
    },
    "nome_fantasia": {
      "type": "string",
      "description": "Nome fantasia"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ (apenas n\u00fameros)"
    },
    "ie": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Estadual"
    },
    "logo_url": {
      "type": "string",
      "description": "URL da logo da oficina"
    },
    "cep": {
      "type": "string",
      "description": "CEP"
    },
    "address": {
      "type": "string",
      "description": "Logradouro"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero"
    },
    "district": {
      "type": "string",
      "description": "Bairro"
    },
    "city": {
      "type": "string",
      "description": "Munic\u00edpio"
    },
    "uf": {
      "type": "string",
      "description": "UF"
    },
    "phone": {
      "type": "string",
      "description": "Telefone"
    },
    "email": {
      "type": "string",
      "description": "Email de contato"
    },
    "admin_email": {
      "type": "string",
      "description": "Email do administrador da empresa que ter\u00e1 acesso ao sistema"
    },
    "admin_name": {
      "type": "string",
      "description": "Nome do administrador da empresa"
    },
    "access_granted": {
      "type": "boolean",
      "default": false,
      "description": "Se o acesso ao sistema foi liberado para o administrador da empresa"
    },
    "responsible_name": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "responsible_cpf": {
      "type": "string",
      "description": "CPF do respons\u00e1vel (apenas n\u00fameros)"
    },
    "inscricao_municipal": {
      "type": "string",
      "description": "Inscri\u00e7\u00e3o Municipal (necess\u00e1ria para NFS-e)"
    },
    "ibge_code": {
      "type": "string",
      "description": "C\u00f3digo IBGE do munic\u00edpio (para NFS-e e endere\u00e7o)"
    },
    "nfse_environment": {
      "type": "string",
      "enum": [
        "1",
        "2"
      ],
      "default": "2",
      "description": "Ambiente NFS-e: 1=Produ\u00e7\u00e3o, 2=Homologa\u00e7\u00e3o"
    },
    "nfse_webservice_url": {
      "type": "string",
      "description": "URL do webservice NFS-e da prefeitura (padr\u00e3o Abrasf)"
    },
    "nfse_serie": {
      "type": "string",
      "default": "1",
      "description": "S\u00e9rie do RPS para NFS-e"
    },
    "nfse_numero_next": {
      "type": "number",
      "default": 1,
      "description": "Pr\u00f3ximo n\u00famero de RPS/NFS-e"
    }
  },
  "required": [
    "user_email",
    "razao_social"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}