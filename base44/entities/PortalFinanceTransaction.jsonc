{
  "name": "PortalFinanceTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que registrou a movimenta\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da movimenta\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor da movimenta\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Tipo: receita ou despesa"
    },
    "category": {
      "type": "string",
      "description": "Categoria da movimenta\u00e7\u00e3o"
    },
    "date": {
      "type": "string",
      "description": "Data da movimenta\u00e7\u00e3o (ISO)"
    },
    "launch_date": {
      "type": "string",
      "description": "Data de lan\u00e7amento (ISO)"
    },
    "due_date": {
      "type": "string",
      "description": "Data de vencimento (ISO)"
    },
    "contact_id": {
      "type": "string",
      "description": "ID do cliente/fornecedor vinculado"
    },
    "contact_name": {
      "type": "string",
      "description": "Nome do cliente/fornecedor vinculado"
    },
    "cost_center_id": {
      "type": "string",
      "description": "ID do centro de custo vinculado"
    },
    "cost_center_name": {
      "type": "string",
      "description": "Nome do centro de custo vinculado"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "settled"
      ],
      "default": "pending",
      "description": "Status: pendente ou baixado"
    },
    "bank_account_id": {
      "type": "string",
      "description": "ID da conta banc\u00e1ria utilizada na baixa"
    },
    "bank_name": {
      "type": "string",
      "description": "Nome do banco utilizado na baixa"
    },
    "settled_date": {
      "type": "string",
      "description": "Data da baixa do t\u00edtulo (ISO)"
    }
  },
  "required": [
    "user_email",
    "description",
    "amount",
    "type"
  ]
}