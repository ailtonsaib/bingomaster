{
  "name": "PortalFinanceTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usu\u00e1rio que registrou a movimenta\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da movimenta\u00e7\u00e3o"
    },
    "amount": {
      "type": "number",
      "description": "Valor da movimenta\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Tipo: receita ou despesa"
    },
    "category": {
      "type": "string",
      "description": "Categoria da movimenta\u00e7\u00e3o"
    },
    "date": {
      "type": "string",
      "description": "Data da movimenta\u00e7\u00e3o (ISO)"
    }
  },
  "required": [
    "user_email",
    "description",
    "amount",
    "type"
  ]
}