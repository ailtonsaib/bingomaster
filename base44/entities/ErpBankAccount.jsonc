{
  "name": "ErpBankAccount",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "bank": {
      "type": "string",
      "description": "Banco"
    },
    "agency": {
      "type": "string"
    },
    "account": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "conta_corrente",
        "poupanca",
        "caixa"
      ],
      "default": "conta_corrente"
    },
    "holder": {
      "type": "string",
      "description": "Titular"
    },
    "chart_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil a que a conta banc\u00e1ria pertence (ErpChartAccount)"
    },
    "chart_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta cont\u00e1bil (cache)"
    },
    "chart_account_name": {
      "type": "string",
      "description": "Nome da conta cont\u00e1bil (cache)"
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "bank"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}