{
  "name": "ErpExpenseParameter",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "name": {
      "type": "string",
      "description": "Nome do par\u00e2metro/configura\u00e7\u00e3o de despesa"
    },
    "operation_id": {
      "type": "string",
      "description": "ID da opera\u00e7\u00e3o de entrada padr\u00e3o (ErpOperation) usada nas despesas"
    },
    "operation_name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o (cache)"
    },
    "cfop_entrada": {
      "type": "string",
      "description": "CFOP de entrada para XML de despesa (NF-e/NFC-e) \u2014 ex: 1102, 2102, 1949, 2949"
    },
    "cfop_entrada_servico": {
      "type": "string",
      "description": "CFOP de entrada para NFS-e (servi\u00e7o) \u2014 ex: 1305, 2305, 1933, 2933"
    },
    "default_department_id": {
      "type": "string",
      "description": "ID do setor/departamento padr\u00e3o sugerido no rateio (ErpDepartment)"
    },
    "default_department_name": {
      "type": "string",
      "description": "Nome do setor padr\u00e3o (cache)"
    },
    "default_account_id": {
      "type": "string",
      "description": "ID da conta cont\u00e1bil padr\u00e3o de despesa sugerida no rateio (ErpChartAccount)"
    },
    "default_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta padr\u00e3o (cache)"
    },
    "default_account_name": {
      "type": "string",
      "description": "Nome da conta padr\u00e3o (cache)"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}