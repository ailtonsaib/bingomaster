{
  "name": "ErpExpenseParameter",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "name": {
      "type": "string",
      "description": "Nome do par\u00e2metro/configura\u00e7\u00e3o de despesa"
    },
    "operation_id": {
      "type": "string",
      "description": "ID da opera\u00e7\u00e3o de entrada padr\u00e3o (ErpOperation) usada nas despesas"
    },
    "operation_name": {
      "type": "string",
      "description": "Nome da opera\u00e7\u00e3o (cache)"
    },
    "cfop_nfe_dentro": {
      "type": "string",
      "description": "CFOP de entrada para NF-e/NFC-e de fornecedor DENTRO do estado (ex: 1102, 1949)"
    },
    "cfop_nfe_fora": {
      "type": "string",
      "description": "CFOP de entrada para NF-e/NFC-e de fornecedor FORA do estado (ex: 2102, 2949)"
    },
    "cfop_nfse_dentro": {
      "type": "string",
      "description": "CFOP de entrada para NFS-e (servi\u00e7o) de fornecedor DENTRO do estado (ex: 1305, 1933)"
    },
    "cfop_nfse_fora": {
      "type": "string",
      "description": "CFOP de entrada para NFS-e (servi\u00e7o) de fornecedor FORA do estado (ex: 2305, 2933)"
    },
    "default_sector_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos setores padr\u00e3o sugeridos no rateio (ErpSector) \u2014 permite N setores"
    },
    "default_sector_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Nomes dos setores padr\u00e3o (cache)"
    },
    "default_account_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs das contas cont\u00e1beis padr\u00e3o sugeridas no rateio (ErpChartAccount) \u2014 permite N contas"
    },
    "default_account_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "C\u00f3digos das contas padr\u00e3o (cache)"
    },
    "default_account_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Nomes das contas padr\u00e3o (cache)"
    },
    "credora_account_id": {
      "type": "string",
      "description": "ID da conta credora principal (Fornecedores / Contas a Pagar / Impostos a Pagar) \u2014 creditada pelo valor l\u00edquido da nota"
    },
    "credora_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta credora (cache)"
    },
    "credora_account_name": {
      "type": "string",
      "description": "Nome da conta credora (cache)"
    },
    "outras_impostos_account_id": {
      "type": "string",
      "description": "ID da conta de 'Outras de Impostos' (despesa) onde caem os impostos sem cr\u00e9dito configurado"
    },
    "outras_impostos_account_code": {
      "type": "string",
      "description": "C\u00f3digo da conta de outras impostos (cache)"
    },
    "outras_impostos_account_name": {
      "type": "string",
      "description": "Nome da conta de outras impostos (cache)"
    },
    "credit_accounts": {
      "type": "array",
      "default": [],
      "description": "Cr\u00e9ditos de impostos recuper\u00e1veis (ICMS, PIS, COFINS) \u2014 conta de d\u00e9bito (a recuperar) para cada tipo configurado",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ICMS",
              "PIS",
              "COFINS"
            ]
          },
          "account_id": {
            "type": "string",
            "description": "ID da conta de cr\u00e9dito (a recuperar) (ErpChartAccount)"
          },
          "account_code": {
            "type": "string",
            "description": "C\u00f3digo da conta (cache)"
          },
          "account_name": {
            "type": "string",
            "description": "Nome da conta (cache)"
          }
        }
      }
    },
    "retentions": {
      "type": "array",
      "default": [],
      "description": "Reten\u00e7\u00f5es de servi\u00e7o (IRRF, PIS, COFINS, CSLL, INSS, ISS) \u2014 cada uma com o fornecedor destinat\u00e1rio e a conta credora (impostos a pagar)",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "IRRF",
              "PIS",
              "COFINS",
              "CSLL",
              "INSS",
              "ISS"
            ]
          },
          "partner_id": {
            "type": "string",
            "description": "ID do fornecedor destinat\u00e1rio do valor retido (ErpPartner)"
          },
          "partner_name": {
            "type": "string",
            "description": "Nome do fornecedor (cache)"
          },
          "account_id": {
            "type": "string",
            "description": "ID da conta credora da reten\u00e7\u00e3o (Impostos a Pagar) (ErpChartAccount)"
          },
          "account_code": {
            "type": "string",
            "description": "C\u00f3digo da conta da reten\u00e7\u00e3o (cache)"
          },
          "account_name": {
            "type": "string",
            "description": "Nome da conta da reten\u00e7\u00e3o (cache)"
          },
          "rate": {
            "type": "number",
            "default": 0,
            "description": "Al\u00edquota da reten\u00e7\u00e3o (%) \u2014 informativa"
          }
        }
      }
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}