{
  "name": "SpedPlanConfig",
  "type": "object",
  "properties": {
    "plan_key": {
      "type": "string",
      "description": "Chave \u00fanica do plano (free, basic, pro, max)"
    },
    "plan_name": {
      "type": "string",
      "description": "Nome exibido do plano"
    },
    "price": {
      "type": "number",
      "description": "Pre\u00e7o do plano em reais (0 = gr\u00e1tis)",
      "default": 0
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "one_time",
        "monthly",
        "quarterly",
        "yearly"
      ],
      "default": "quarterly",
      "description": "Ciclo de cobran\u00e7a: one_time (\u00fanico), monthly (mensal), quarterly (trimestral), yearly (anual)"
    },
    "downloads_limit": {
      "type": "number",
      "description": "Limite de downloads (null = ilimitado)",
      "default": null
    },
    "sped_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "FISCAL",
          "CONTRIBUICOES",
          "ECD",
          "ECF",
          "DIMESC",
          "REINF"
        ]
      },
      "description": "Tipos de SPED liberados neste plano"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o curta do plano"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o plano est\u00e1 ativo"
    },
    "order": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o"
    }
  },
  "required": [
    "plan_key",
    "plan_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}