{
  "name": "Rifa",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome/t\u00edtulo da rifa"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do pr\u00eamio ou evento"
    },
    "prize": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do pr\u00eamio principal"
    },
    "ticket_price": {
      "type": "number",
      "description": "Valor de cada n\u00famero da rifa em reais"
    },
    "total_tickets": {
      "type": "number",
      "description": "Quantidade total de n\u00fameros da rifa"
    },
    "event_date": {
      "type": "string",
      "description": "Data do sorteio (ISO string)"
    },
    "event_location": {
      "type": "string",
      "description": "Local do sorteio"
    },
    "organizer_name": {
      "type": "string",
      "description": "Nome do organizador/respons\u00e1vel"
    },
    "organizer_phone": {
      "type": "string",
      "description": "Telefone do organizador"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "finished"
      ],
      "default": "active",
      "description": "Status da rifa"
    },
    "winner_number": {
      "type": "number",
      "description": "N\u00famero sorteado vencedor"
    },
    "image_url": {
      "type": "string",
      "description": "URL da imagem do pr\u00eamio"
    },
    "tickets_per_page": {
      "type": "number",
      "default": 10,
      "description": "Quantidade de canhotos por p\u00e1gina para impress\u00e3o"
    }
  },
  "required": [
    "name",
    "total_tickets",
    "ticket_price"
  ]
}