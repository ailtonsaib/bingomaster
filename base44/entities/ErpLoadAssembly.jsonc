{
  "name": "ErpLoadAssembly",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero da carga (ex: CARGA 001/2026)"
    },
    "load_date": {
      "type": "string",
      "description": "Data da montagem da carga (ISO)"
    },
    "vehicle_id": {
      "type": "string",
      "description": "ID do ve\u00edculo (ErpFleetVehicle)"
    },
    "vehicle_plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo (cache)"
    },
    "driver_id": {
      "type": "string",
      "description": "ID do motorista (ErpFleetDriver)"
    },
    "driver_name": {
      "type": "string",
      "description": "Nome do motorista (cache)"
    },
    "orders": {
      "type": "array",
      "default": [],
      "description": "Pedidos de venda atrelados \u00e0 carga",
      "items": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "description": "ID do pedido (ErpSalesOrder)"
          },
          "order_number": {
            "type": "string",
            "description": "N\u00famero do pedido (cache)"
          },
          "customer_name": {
            "type": "string",
            "description": "Cliente (cache)"
          },
          "seller_name": {
            "type": "string",
            "description": "Vendedor (cache do cliente)"
          },
          "city": {
            "type": "string",
            "description": "Munic\u00edpio do cliente (cache)"
          },
          "district": {
            "type": "string",
            "description": "Bairro do cliente (cache)"
          },
          "total": {
            "type": "number",
            "default": 0,
            "description": "Valor total do pedido (R$)"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "default": [],
      "description": "Produtos consolidados da carga com paletiza\u00e7\u00e3o e endere\u00e7o/lote de separa\u00e7\u00e3o (WMS)",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string",
            "description": "ID do produto (ErpProduct)"
          },
          "product_code": {
            "type": "string",
            "description": "C\u00f3digo do produto (cache)"
          },
          "product_name": {
            "type": "string",
            "description": "Nome do produto (cache)"
          },
          "unit": {
            "type": "string",
            "description": "Unidade (cache)"
          },
          "quantity": {
            "type": "number",
            "default": 0,
            "description": "Quantidade total consolidada (volumes)"
          },
          "fator_pallet": {
            "type": "number",
            "default": 0,
            "description": "Fator pallet do produto \u2014 volumes por pallet (cache)"
          },
          "volumes_por_camada": {
            "type": "number",
            "default": 0,
            "description": "Volumes por camada (cache)"
          },
          "quantidade_camadas": {
            "type": "number",
            "default": 0,
            "description": "Camadas por pallet (cache)"
          },
          "pallets": {
            "type": "number",
            "default": 0,
            "description": "Pallets completos (quantidade \u00f7 fator pallet)"
          },
          "loose_volumes": {
            "type": "number",
            "default": 0,
            "description": "Volumes avulsos (resto fora dos pallets completos)"
          },
          "layers": {
            "type": "number",
            "default": 0,
            "description": "Camadas dos volumes avulsos"
          },
          "controla_lote": {
            "type": "boolean",
            "default": false,
            "description": "Se o produto controla lote (cache)"
          },
          "wms": {
            "type": "array",
            "default": [],
            "description": "Endere\u00e7o/lote de separa\u00e7\u00e3o (quando a empresa usa WMS): saldo por endere\u00e7o alocado por validade (FEFO)",
            "items": {
              "type": "object",
              "properties": {
                "warehouse_name": {
                  "type": "string",
                  "description": "Armaz\u00e9m"
                },
                "location_code": {
                  "type": "string",
                  "description": "Endere\u00e7o (ex: A-01-02-03)"
                },
                "lot": {
                  "type": "string",
                  "description": "Lote a retirar"
                },
                "expiry_date": {
                  "type": "string",
                  "description": "Validade do lote (ISO)"
                },
                "quantity": {
                  "type": "number",
                  "default": 0,
                  "description": "Quantidade a retirar deste endere\u00e7o/lote"
                },
                "pending": {
                  "type": "boolean",
                  "default": false,
                  "description": "Sem saldo endere\u00e7ado no WMS para esta quantidade"
                }
              }
            }
          }
        }
      }
    },
    "total_volumes": {
      "type": "number",
      "default": 0,
      "description": "Total de volumes da carga"
    },
    "total_pallets": {
      "type": "number",
      "default": 0,
      "description": "Total de pallets completos da carga"
    },
    "total_weight": {
      "type": "number",
      "default": 0,
      "description": "Peso total da carga (kg) \u2014 soma dos volumes \u00d7 peso bruto de cada produto; comparado com a tara do ve\u00edculo"
    },
    "status": {
      "type": "string",
      "enum": [
        "montada",
        "carregada",
        "cancelada"
      ],
      "default": "montada",
      "description": "Status: montada (aguarda separa\u00e7\u00e3o/carregamento), carregada ou cancelada"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "number"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}