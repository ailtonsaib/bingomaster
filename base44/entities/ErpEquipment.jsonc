{
  "name": "ErpEquipment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo do equipamento"
    },
    "name": {
      "type": "string",
      "description": "Nome do equipamento/m\u00e1quina"
    },
    "category": {
      "type": "string",
      "description": "Grupo/categoria (ex: Inje\u00e7\u00e3o, Usinagem, Utilidades)"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o f\u00edsica (setor/galp\u00e3o)"
    },
    "responsible": {
      "type": "string",
      "description": "Respons\u00e1vel pelo equipamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "em_manutencao",
        "inativo"
      ],
      "default": "ativo",
      "description": "Situa\u00e7\u00e3o: ativo, em_manutencao, inativo"
    },
    "acquisition_date": {
      "type": "string",
      "description": "Data de aquisi\u00e7\u00e3o (ISO)"
    },
    "acquisition_value": {
      "type": "number",
      "default": 0,
      "description": "Valor de aquisi\u00e7\u00e3o (R$)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es t\u00e9cnicas"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}