{
  "name": "ErpMaintenanceOrder",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo)"
    },
    "number": {
      "type": "string",
      "description": "N\u00famero da ordem de servi\u00e7o (ex: OS 001/2026)"
    },
    "equipment_id": {
      "type": "string",
      "description": "ID do equipamento (ErpEquipment)"
    },
    "equipment_name": {
      "type": "string",
      "description": "Nome do equipamento (cache)"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "preventiva",
        "corretiva",
        "preditiva"
      ],
      "default": "corretiva",
      "description": "Tipo: preventiva, corretiva ou preditiva"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o / problema relatado"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "em_execucao",
        "concluida",
        "cancelada"
      ],
      "default": "aberta",
      "description": "Status: aberta, em_execucao, concluida, cancelada"
    },
    "responsible": {
      "type": "string",
      "description": "Respons\u00e1vel/t\u00e9cnico pela execu\u00e7\u00e3o"
    },
    "opened_date": {
      "type": "string",
      "description": "Data de abertura (ISO)"
    },
    "scheduled_date": {
      "type": "string",
      "description": "Data prevista/agendada da execu\u00e7\u00e3o (ISO) \u2014 usada no calend\u00e1rio de OS"
    },
    "plan_id": {
      "type": "string",
      "description": "ID do plano preventivo de origem (ErpMaintenancePlan) \u2014 OS preventiva gerada automaticamente"
    },
    "checklist_items": {
      "type": "array",
      "default": [],
      "description": "Checklist de execu\u00e7\u00e3o da OS (itens marcados durante o servi\u00e7o)",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          },
          "done": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "closed_date": {
      "type": "string",
      "description": "Data de fechamento (ISO)"
    },
    "downtime_hours": {
      "type": "number",
      "default": 0,
      "description": "Horas de parada do equipamento (MTTR)"
    },
    "cost": {
      "type": "number",
      "default": 0,
      "description": "Custo total da manuten\u00e7\u00e3o (pe\u00e7as + m\u00e3o de obra)"
    },
    "parts_notes": {
      "type": "string",
      "description": "Pe\u00e7as de reposi\u00e7\u00e3o utilizadas"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es/laudo t\u00e9cnico"
    }
  },
  "required": [
    "user_email",
    "number",
    "equipment_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}