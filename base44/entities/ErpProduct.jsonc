{
  "name": "ErpProduct",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do operador (escopo da empresa)"
    },
    "code": {
      "type": "string",
      "description": "C\u00f3digo interno do produto"
    },
    "barcode": {
      "type": "string",
      "description": "C\u00f3digo de barras (GTIN/EAN)"
    },
    "name": {
      "type": "string",
      "description": "Nome/descri\u00e7\u00e3o do produto"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "materia_prima",
        "mercadoria",
        "produto_acabado",
        "produto_em_processo",
        "insumo",
        "servico"
      ],
      "default": "mercadoria",
      "description": "Tipo: materia_prima (ind\u00fastria), mercadoria (revenda/com\u00e9rcio), produto_acabado (ind\u00fastria), produto_em_processo, insumo, servico"
    },
    "category": {
      "type": "string",
      "description": "Categoria/grupo do produto"
    },
    "ncm": {
      "type": "string",
      "description": "NCM (Nomenclatura Comum do Mercosul)"
    },
    "unit": {
      "type": "string",
      "default": "UN",
      "description": "Unidade de medida (UN, KG, LT, M, CX, etc.)"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Quantidade em estoque atual"
    },
    "min_stock": {
      "type": "number",
      "default": 0,
      "description": "Estoque m\u00ednimo (ponto de reposi\u00e7\u00e3o)"
    },
    "cost_price": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o de custo (\u00faltimo)"
    },
    "sale_price": {
      "type": "number",
      "default": 0,
      "description": "Pre\u00e7o de venda"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se o produto est\u00e1 ativo"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "user_email",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}