{
  "name": "SupportCompany",
  "type": "object",
  "properties": {
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o Social da empresa"
    },
    "cnpj": {
      "type": "string",
      "description": "CNPJ (apenas n\u00fameros)"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Se a empresa est\u00e1 ativa"
    },
    "ticket_plan": {
      "type": "string",
      "enum": [
        "free",
        "full"
      ],
      "default": "free",
      "description": "Plano de chamados: free (10 chamados) ou full (ilimitado)"
    },
    "ticket_limit": {
      "type": "number",
      "default": 10,
      "description": "Limite de chamados no plano free"
    },
    "ticket_full_access": {
      "type": "boolean",
      "default": false,
      "description": "Se a empresa tem acesso completo (ilimitado) liberado pelo admin"
    },
    "logo_url": {
      "type": "string",
      "description": "URL do logo da empresa"
    }
  },
  "required": [
    "razao_social",
    "cnpj"
  ]
}