{
  "name": "SellerDistribution",
  "type": "object",
  "properties": {
    "game_id": {
      "type": "string",
      "description": "ID do jogo"
    },
    "seller_id": {
      "type": "string",
      "description": "ID do vendedor"
    },
    "seller_name": {
      "type": "string",
      "description": "Nome do vendedor"
    },
    "range_from": {
      "type": "number",
      "description": "N\u00famero inicial do intervalo de cartelas"
    },
    "range_to": {
      "type": "number",
      "description": "N\u00famero final do intervalo de cartelas"
    }
  },
  "required": [
    "game_id",
    "seller_id",
    "range_from",
    "range_to"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}